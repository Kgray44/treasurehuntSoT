  revokedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([voyageLogId, participantId, purpose])
}

model CommunityVoyageLogConsentAudit {
  id             String   @id @default(cuid())
  voyageLogId    String
  participantId  String?
  actorAccountId String
  purpose        String
  action         String
  state          String
  occurredAt     DateTime @default(now())

  @@index([voyageLogId, occurredAt])
  @@index([participantId, occurredAt])
}

model CommunityVoyageLogMedia {
  id                         String   @id @default(cuid())
  voyageLogId                String
  privateMediaReference      String
  sourceChecksum             String
  subjectParticipantId       String?
  detectedMediaType          String
  derivativeChecksum         String
  derivativeStorageReference String
  processingStatus           String   @default("PENDING")
  scanStatus                 String   @default("SCAN_NOT_CONFIGURED")
  exifGpsRemoved             Boolean  @default(false)
  createdAt                  DateTime @default(now())

  @@unique([voyageLogId, derivativeChecksum])
  @@unique([voyageLogId, privateMediaReference])
}

model CommunityVoyageLogMediaConsent {
  id                         String    @id @default(cuid())
  voyageLogMediaId           String
  accountId                  String
  purpose                    String
  approvedOpaqueMediaId      String?
  approvedSourceChecksum     String?
  approvedDerivativeChecksum String?
  subjectParticipantId       String?
  grantedAt                  DateTime?
  revokedAt                  DateTime?

  @@unique([voyageLogMediaId, accountId, purpose])
}

model CommunityVoyageLogShareRestriction {
  id               String   @id @default(cuid())
  voyageLogId      String
  restrictionType  String
  subjectReference String?
  createdAt        DateTime @default(now())

  @@index([voyageLogId, restrictionType])
}

model CommunityGuideContent {
  id             String    @id @default(cuid())
  ownerProfileId String
  slug           String    @unique
  title          String
  safeSummary    String
  sanitizedBody  String
  category       String
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  deprecatedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, category, publishedAt])
}
