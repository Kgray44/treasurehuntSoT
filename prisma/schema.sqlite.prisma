}

model TaleSession {
  id                     String                     @id @default(cuid())
  taleId                 String
  publishedVersionId     String?
  ownerLabel             String?
  voyageName             String?
  captainId              String?
  captainAccountId       String?
  captainAuthorityState  String                     @default("ASSIGNED")
  accessTokenHash        String                     @unique
  status                 String                     @default("ACTIVE")
  captainMode            String                     @default("CAPTAIN_CONTROLLED")
  configuration          String                     @default("{}")
  scheduleTimezone       String?
  plannedStartAt         DateTime?
  launchedAt             DateTime?
  cancelledAt            DateTime?
  abandonedAt            DateTime?
  concurrencyVersion     Int                        @default(0)
  historicalHidden       Boolean                    @default(false)
  archiveMetadata        String                     @default("{}")
  currentChapterId       String?
  currentBlockId         String?
  currentSequence        Int                        @default(0)
  previewMode            Boolean                    @default(false)
  draftRevisionId        String?
  previewSnapshot        String?
  variables              String                     @default("{}")
  inventory              String                     @default("[]")
  startedAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  completedAt            DateTime?
  expiresAt              DateTime?
  lastHeartbeatAt        DateTime?
  tale                   Chronicle                  @relation(fields: [taleId], references: [id], onDelete: Cascade)
  version                PublishedTaleVersion?      @relation(fields: [publishedVersionId], references: [id])
  events                 TaleSessionEvent[]
  privateAssetReferences PrivateAssetReference[]
  verificationRequests   TaleVerificationRequest[]
  helperPairings         TaleHelperPairing[]
  memberships            PlaythroughMembership[]
  presenceDevices        MembershipPresenceDevice[]
  invitations            Invitation[]
  revealStates           RevealState[]
  artifactGrantReceipts  ArtifactGrantReceipt[]
  captainAccount         UserAccount?               @relation("TaleSessionCaptainAccount", fields: [captainAccountId], references: [id], onDelete: SetNull)

  @@index([taleId, status, previewMode])
  @@index([publishedVersionId, status])
  @@index([captainAccountId, status])
  @@index([captainAuthorityState, status])
}

// Helm A2 keeps authority changes and personal continuations as durable,
// source-bound lifecycle receipts. These are deliberately separate from
// canonical progression events: they never become a second progression log.
model VoyageCaptainAuthorityReceipt {
  id                       String   @id @default(cuid())
  voyageId                 String
  action                   String
  previousCaptainAccountId String?
  nextCaptainAccountId     String?
  authorityState           String
  sourceConcurrencyVersion Int
  sourceSequence           Int
  idempotencyKey           String   @unique
  correlationId            String   @unique
  safeReason               String?
  committedAt              DateTime @default(now())

  @@index([voyageId, committedAt])
  @@index([nextCaptainAccountId, committedAt])
}

model VoyageForkLineage {
  id                       String   @id @default(cuid())
  parentVoyageId           String
  childVoyageId            String   @unique
  sourceConcurrencyVersion Int
  sourceSequence           Int
  requesterPlayerProfileId String
  requesterAccountId       String?
  idempotencyKey           String   @unique
  correlationId            String   @unique
  createdAt                DateTime @default(now())

  @@index([parentVoyageId, createdAt])
  @@index([requesterPlayerProfileId, createdAt])
}

// One Voyage-owned immutable recipient resolution for a canonical artifactGranted
// event. Wayfarer projects this receipt and never invents personal ownership.
model ArtifactGrantReceipt {
  id                             String      @id @default(cuid())
  sessionId                      String
  sourceEventId                  String      @unique
  grantId                        String      @unique
  schemaVersion                  Int         @default(1)
  artifactDefinitionId           String
  artifactOccurrenceId           String
  publishedVersionId             String
  sourceBlockId                  String?
  recipientPolicy                String
  resolvedRecipientMembershipIds String
  resolvedRecipientProfileIds    String
  discoveringMembershipId        String?
  requiredCrewRole               String?
  sharedInventoryAction          String
  personalGrantState             String
  custodyKind                    String
  assemblyDefinitionId           String?
  componentRole                  String?
  receiptState                   String      @default("ACTIVE")
  occurredAt                     DateTime
  correctionOfGrantId            String?
  correctionReason               String?
  createdAt                      DateTime    @default(now())
  session                        TaleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([publishedVersionId, artifactDefinitionId])
}

model PlayerProfile {
  id                    String                   @id @default(cuid())
  accountId             String?                  @unique
  username              String?                  @unique
  passwordHash          String?
  displayName           String
  normalizedDisplayName String?                  @unique
  handle                String?
  normalizedHandle      String?                  @unique
  biography             String?
  avatarMediaId         String?                  @unique
  bannerMediaId         String?                  @unique
  defaultVisibility     String                   @default("REGISTERED_USERS")
  status                String                   @default("ACTIVE")
  preferences           String                   @default("{}")
  claimedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  lastSeenAt            DateTime?
  sessions              PlayerIdentitySession[]
  memberships           PlaythroughMembership[]
  invitations           Invitation[]
  handleHistory         ProfileHandleHistory[]
  media                 ProfileMedia[]           @relation("ProfileMediaOwner")
  avatarMedia           ProfileMedia?            @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerMedia           ProfileMedia?            @relation("ProfileBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  preferenceSet         ProfilePreferenceSet?
  privacyRules          ProfilePrivacyRule[]
  chronicleRecords      PlayerChronicleRecord[]
  chronicleMemories     ChronicleMemory[]
  keepsakeConsents      VoyageKeepsakeConsent[]
  artifactRecords       PlayerArtifactRecord[]
  artifactCases         ArtifactDisplayCase[]
  artifactAssemblies    PlayerArtifactAssembly[]
  achievements          PlayerAchievement[]
