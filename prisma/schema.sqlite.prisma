}

model PlatformRoleAssignment {
  id        String         @id @default(cuid())
  accountId String
  role      String
  scopeType String         @default("GLOBAL")
  scopeId   String?
  grantedBy String?
  grantedAt DateTime       @default(now())
  revokedAt DateTime?
  account   GameMasterUser @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role, scopeType, scopeId])
  @@index([role, scopeType, scopeId, revokedAt])
}

model PlaythroughMembership {
  id                         String                     @id @default(cuid())
  playthroughId              String
  playerProfileId            String
  role                       String                     @default("PLAYER")
  status                     String                     @default("INVITED")
  crewRole                   String?
  participationAlias         String?
  participationAliasEditedAt DateTime?
  joinedAt                   DateTime?
  removedAt                  DateTime?
  completedAt                DateTime?
  pinnedAt                   DateTime?
  hiddenAt                   DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  playthrough                TaleSession                @relation(fields: [playthroughId], references: [id], onDelete: Cascade)
  player                     PlayerProfile              @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  presenceDevices            MembershipPresenceDevice[]

  @@unique([playthroughId, playerProfileId])
  @@index([playerProfileId, status, updatedAt])
}

// Platform-owned, membership-scoped operational evidence. These records are
// not Chronicle progression, a Helm state store, or a device fingerprint.
model MembershipPresenceDevice {
  id                      String                @id @default(cuid())
  playthroughMembershipId String
  taleSessionId           String
  deviceInstanceId        String
  lastHeartbeatAt         DateTime              @default(now())
  acknowledgedSequence    Int                   @default(0)
  safeActivity            String?
  connectionGeneration    Int                   @default(0)
  disconnectedAt          DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  membership              PlaythroughMembership @relation(fields: [playthroughMembershipId], references: [id], onDelete: Cascade)
  taleSession             TaleSession           @relation(fields: [taleSessionId], references: [id], onDelete: Cascade)

  @@unique([playthroughMembershipId, deviceInstanceId])
  @@index([taleSessionId, lastHeartbeatAt])
  @@index([playthroughMembershipId, lastHeartbeatAt])
}

model AccountDataExport {
