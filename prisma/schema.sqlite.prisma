  account          UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, kind, state])
  @@index([kind, state, scheduledFor])
}

// A Wayfarer-owned, materialized historical projection. Source identifiers are
// scalar by design so source retention or future tombstoning cannot rewrite a
// person's historical record.
model PlayerChronicleRecord {
  id                         String                               @id @default(cuid())
  playerProfileId            String
  sourcePlaythroughId        String
  sourceMembershipId         String?
  publishedVersionId         String
  publishedVersionChecksum   String
  chronicleTitleSnapshot     String
  chronicleCoverSnapshot     String?
  creatorAttributionSnapshot String?
  playerNameSnapshot         String
  playerAvatarSnapshot       String?
  participationRole          String                               @default("PLAYER")
  crewRoleSnapshot           String?
  lifecycleStatus            String
  outcome                    String                               @default("UNAVAILABLE")
  startedAt                  DateTime?
  joinedAt                   DateTime?
  completedAt                DateTime?
  wallClockSeconds           Int?
  activeSeconds              Int?
  pausedSeconds              Int?
  connectedSeconds           Int?
  interactiveSeconds         Int?
  captainWaitSeconds         Int?
  wallClockAccuracy          String                               @default("UNAVAILABLE")
  activeAccuracy             String                               @default("UNAVAILABLE")
  pausedAccuracy             String                               @default("UNAVAILABLE")
  connectedAccuracy          String                               @default("UNAVAILABLE")
  interactiveAccuracy        String                               @default("UNAVAILABLE")
  captainWaitAccuracy        String                               @default("UNAVAILABLE")
  metricDefinitionVersion    String                               @default("WAYFARER_TIMING_V1")
  completedChapters          String                               @default("[]")
  optionalObjectives         String                               @default("[]")
  choiceSummary              String                               @default("[]")
  artifactSummary            String                               @default("[]")
  sourceFingerprint          String
  projectionStatus           String                               @default("CURRENT")
  projectionReason           String?
  lastDerivedAt              DateTime                             @default(now())
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  player                     PlayerProfile                        @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  publishedVersion           PublishedTaleVersion                 @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)
  reflection                 ChronicleReflection?
  memories                   ChronicleMemory[]
  keepsake                   VoyageKeepsake?
  participantSnapshots       PlayerChronicleParticipantSnapshot[]

  @@unique([playerProfileId, sourcePlaythroughId])
  @@index([playerProfileId, lifecycleStatus, completedAt])
  @@index([playerProfileId, chronicleTitleSnapshot])
  @@index([publishedVersionId])
}

model ChronicleReflection {
  id                        String                @id @default(cuid())
  playerChronicleRecordId   String                @unique
  favoriteChapterId         String?
  favoriteClueReference     String?
  favoriteMomentReference   String?
  favoriteArtifactReference String?
  privateNote               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  record                    PlayerChronicleRecord @relation(fields: [playerChronicleRecordId], references: [id], onDelete: Cascade)
}

model ChronicleMemory {
  id                      String                @id @default(cuid())
  playerChronicleRecordId String
  playerProfileId         String
  title                   String
  body                    String?
  referenceType           String?
  referenceId             String?
  visibility              String                @default("ONLY_ME")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?
  record                  PlayerChronicleRecord @relation(fields: [playerChronicleRecordId], references: [id], onDelete: Cascade)
  owner                   PlayerProfile         @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerChronicleRecordId, deletedAt, createdAt])
  @@index([playerProfileId, deletedAt])
}

model PlayerChronicleParticipantSnapshot {
  id                    String                @id @default(cuid())
  historyRecordId       String
  sourceMembershipId    String
  participantProfileId  String?
  displayNameSnapshot   String
  avatarAltSnapshot     String?
  participationRole     String
  crewRoleSnapshot      String?
  joinedAt              DateTime?
  completedAt           DateTime?
  removedAt             DateTime?
  projectionEligibility String                @default("ONLY_ME")
  tombstoneState        String                @default("ACTIVE")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  record                PlayerChronicleRecord @relation(fields: [historyRecordId], references: [id], onDelete: Cascade)

  @@unique([historyRecordId, sourceMembershipId])
  @@index([historyRecordId, projectionEligibility])
}

model VoyageKeepsake {
  id                      String                  @id @default(cuid())
  playerChronicleRecordId String                  @unique
  status                  String                  @default("READY")
  presentationPayload     String                  @default("{}")
  generatedAt             DateTime                @default(now())
  regeneratedAt           DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
