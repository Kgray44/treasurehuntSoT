generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  status             String              @default("PAUSED")
  accessCodeHash     String
  currentSequence    Int                 @default(0)
  finaleState        String              @default("SEALED")
  finaleTeaser       String?
  finaleRequirements String              @default("[]")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  chapters           Chapter[]
  artifacts          Artifact[]
  mapLocations       MapLocation[]
  mapRoutes          MapRoute[]
  sideQuests         SideQuest[]
  events             ProgressEvent[]
  snapshots          CampaignSnapshot[]
  awards             ArtifactAward[]
  journalEntries     JournalEntry[]
  auditLogs          AdminAuditLog[]
  saveStates         SaveStateSnapshot[]
  playerAccesses     PlayerAccess[]
  preparedActions    PreparedAction[]
  commandExecutions  CommandExecution[]
  playerPresences    PlayerPresence[]
}

model PlayerAccess {
  id            String           @id @default(cuid())
  campaignId    String
  tokenHash     String           @unique
  label         String?
  expiresAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime         @default(now())
  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audio         AudioPreference?
  presences     PlayerPresence[]
  viewedContent ViewedContent[]

  @@index([campaignId])
}

model PlayerPresence {
  id                   String       @id @default(cuid())
  campaignId           String
  playerAccessId       String
  deviceId             String
  route                String?
  visibility           String?
  connectedAt          DateTime     @default(now())
  lastHeartbeatAt      DateTime     @default(now())
  disconnectedAt       DateTime?
  acknowledgedSequence Int          @default(0)
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  playerAccess         PlayerAccess @relation(fields: [playerAccessId], references: [id], onDelete: Cascade)

  @@unique([campaignId, deviceId])
  @@index([campaignId, lastHeartbeatAt])
}

model GameMasterUser {
  id               String                   @id @default(cuid())
  username         String                   @unique
  passwordHash     String
  role             String                   @default("CAPTAIN_CREATOR")
  capabilities     String                   @default("[]")
  createdAt        DateTime                 @default(now())
  sessions         GameMasterSession[]
  auditLogs        AdminAuditLog[]
  platformRoles    PlatformRoleAssignment[]
  canonicalAccount UserAccount?             @relation("LegacyGameMasterAccount")
}

model UserAccount {
  id                       String                       @id @default(cuid())
  status                   String                       @default("PENDING_VERIFICATION")
  legacyGameMasterId       String?                      @unique
  claimedAt                DateTime?
  lastSeenAt               DateTime?
  lockedAt                 DateTime?
  suspendedAt              DateTime?
  ordinaryWorkspaceEntryAt DateTime?
  mergedIntoAccountId      String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  profile                  PlayerProfile?
  legacyGameMaster         GameMasterUser?              @relation("LegacyGameMasterAccount", fields: [legacyGameMasterId], references: [id], onDelete: SetNull)
  emails                   AccountEmail[]
  credential               AccountCredential?
  tokens                   AccountToken[]
  sessions                 AccountSession[]
  roles                    AccountRoleAssignment[]
  securityEvents           SecurityEvent[]
  migrationRecords         WayfarerMigrationRecord[]
  createdChronicles        Chronicle[]                  @relation("ChronicleCreatorAccount")
  authoredDrafts           TaleDraft[]                  @relation("TaleDraftAuthorAccount")
  publishedVersions        PublishedTaleVersion[]       @relation("PublishedVersionAuthorAccount")
  tideglassAnnotations     TideglassCreatorAnnotation[] @relation("TideglassAnnotationAuthor")
  drydockWaiversAuthorized DrydockRuleWaiver[]          @relation("DrydockWaiverAuthor")
  createdAssets            TaleAsset[]                  @relation("TaleAssetAuthorAccount")
  captainedSessions        TaleSession[]                @relation("TaleSessionCaptainAccount")
  createdInvitations       Invitation[]                 @relation("InvitationCreatorAccount")
  invitationEvents         InvitationEvent[]            @relation("InvitationEventActorAccount")
  revealActions            RevealState[]                @relation("RevealActorAccount")
  auditActions             PlatformAuditEvent[]         @relation("PlatformAuditActorAccount")
  privateImports           PrivateContentImport[]       @relation("PrivateImportOwnerAccount")
  privateAssetRefs         PrivateAssetReference[]      @relation("PrivateAssetOwnerAccount")
  privateOperations        PrivateContentOperation[]    @relation("PrivateOperationOwnerAccount")
  communityProfile         CommunityProfile?
  externalIdentities       ExternalIdentity[]
  providerAttempts         ProviderLinkAttempt[]
  dataExports              AccountDataExport[]
  lifecycleRequests        AccountLifecycleRequest[]
  profileMedia             ProfileMedia[]
  transactionalDeliveries  TransactionalEmailDelivery[]
  privilegedAssurances     PrivilegedAssurance[]        @relation("PrivilegedAssuranceAccount")
  supportRequestsInitiated SupportAccessRequest[]       @relation("SupportRequestOperator")
  supportRequestsTargeted  SupportAccessRequest[]       @relation("SupportRequestTarget")
  supportRequestsDecided   SupportAccessRequest[]       @relation("SupportRequestDecision")
  supportGrantsOperated    SupportAccessGrant[]         @relation("SupportGrantOperator")
  supportGrantsTargeted    SupportAccessGrant[]         @relation("SupportGrantTarget")
  supportGrantsRevoked     SupportAccessGrant[]         @relation("SupportGrantRevoker")
  supportCasesOpened       SupportCase[]                @relation("SupportCaseOperator")
  supportCasesTargeted     SupportCase[]                @relation("SupportCaseTarget")
  supportExecutionGrants   SupportExecutionGrant[]      @relation("SupportExecutionGrantOperator")
  supportExecutionTargets  SupportExecutionGrant[]      @relation("SupportExecutionGrantTarget")
  supportExecutionSessions SupportExecutionSession[]    @relation("SupportExecutionSessionOperator")
  reusableAuthoringItems   ReusableAuthoringItem[]      @relation("ReusableAuthoringItemOwner")

  @@index([status, lastSeenAt])
}

model AccountEmail {
  id                String      @id @default(cuid())
  accountId         String
  normalizedEmail   String      @unique
  displayEmail      String
  isPrimary         Boolean     @default(true)
  verificationState String      @default("PENDING")
  verifiedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  account           UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, isPrimary])
  @@index([accountId, verificationState])
}

model AccountCredential {
  id           String      @id @default(cuid())
  accountId    String      @unique
  passwordHash String
  algorithm    String      @default("bcrypt")
  changedAt    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  account      UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountToken {
  id                     String                      @id @default(cuid())
  accountId              String
  purpose                String
  tokenHash              String                      @unique
  expiresAt              DateTime
  consumedAt             DateTime?
  attemptCount           Int                         @default(0)
  maxAttempts            Int                         @default(5)
  lastAttemptAt          DateTime?
  pendingNormalizedEmail String?
  pendingDisplayEmail    String?
  createdAt              DateTime                    @default(now())
  account                UserAccount                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  delivery               TransactionalEmailDelivery?

  @@index([accountId, purpose, expiresAt])
}

model AccountSession {
  id                   String                @id @default(cuid())
  accountId            String
  tokenHash            String                @unique
  csrfToken            String
  deviceLabel          String?
  sessionType          String                @default("ORDINARY")
  expiresAt            DateTime
  lastSeenAt           DateTime              @default(now())
  revokedAt            DateTime?
  createdAt            DateTime              @default(now())
  account              UserAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  privilegedAssurances PrivilegedAssurance[]

  @@index([accountId, expiresAt])
}

model TransactionalEmailDelivery {
  id                String        @id @default(cuid())
  accountId         String
  accountTokenId    String?       @unique
  purpose           String
  provider          String
  recipientHash     String
  providerMessageId String?       @unique
  status            String        @default("PENDING")
  submittedAt       DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  failureCode       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  account           UserAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountToken      AccountToken? @relation(fields: [accountTokenId], references: [id], onDelete: SetNull)

  @@index([accountId, purpose, createdAt])
  @@index([status, createdAt])
}

model TransactionalEmailEvent {
  id                String   @id @default(cuid())
  providerEventKey  String   @unique
  providerMessageId String
  recordType        String
  payloadChecksum   String
  receivedAt        DateTime @default(now())

  @@index([providerMessageId, recordType])
}

model AccountRoleAssignment {
  id        String      @id @default(cuid())
  accountId String
  role      String
  scopeType String      @default("GLOBAL")
  scopeId   String?
  grantedBy String?
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  account   UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role, scopeType, scopeId])
  @@index([role, scopeType, scopeId, revokedAt])
}

model SecurityEvent {
  id            String      @id @default(cuid())
  accountId     String
  eventType     String
  correlationId String?
  metadata      String      @default("{}")
  createdAt     DateTime    @default(now())
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model PrivilegedAssurance {
  id               String         @id @default(cuid())
  accountId        String
  accountSessionId String
  assuranceLevel   String         @default("ADMIN_REAUTHENTICATED")
  method           String
  issuedAt         DateTime       @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  correlationId    String
  account          UserAccount    @relation("PrivilegedAssuranceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  accountSession   AccountSession @relation(fields: [accountSessionId], references: [id], onDelete: Cascade)

  @@index([accountId, accountSessionId, expiresAt, revokedAt])
  @@index([correlationId])
}

model SupportAccessRequest {
  id                        String              @id @default(cuid())
  requestingAdminAccountId  String
  targetAccountId           String
  purpose                   String
  requestedScopes           String
  status                    String              @default("REQUESTED")
  requestedAt               DateTime            @default(now())
  expiresAt                 DateTime
  decisionAt                DateTime?
  decisionByTargetAccountId String?
  cancelledAt               DateTime?
  correlationId             String              @unique
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  requestingAdmin           UserAccount         @relation("SupportRequestOperator", fields: [requestingAdminAccountId], references: [id], onDelete: Restrict)
  targetAccount             UserAccount         @relation("SupportRequestTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  decisionByTargetAccount   UserAccount?        @relation("SupportRequestDecision", fields: [decisionByTargetAccountId], references: [id], onDelete: SetNull)
  grant                     SupportAccessGrant?
  supportCase               SupportCase?          @relation("SupportCaseAccessRequest")

  @@index([targetAccountId, status, expiresAt])
  @@index([requestingAdminAccountId, status, expiresAt])
}

model SupportAccessGrant {
  id                 String               @id @default(cuid())
  requestId          String               @unique
  operatorAccountId  String
  targetAccountId    String
  grantedScopes      String
  status             String               @default("ACTIVE")
  issuedAt           DateTime             @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByAccountId String?
  revocationReason   String?
  correlationId      String
  request            SupportAccessRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  operator           UserAccount          @relation("SupportGrantOperator", fields: [operatorAccountId], references: [id], onDelete: Restrict)
  targetAccount      UserAccount          @relation("SupportGrantTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  revokedBy          UserAccount?         @relation("SupportGrantRevoker", fields: [revokedByAccountId], references: [id], onDelete: SetNull)
  executionGrants    SupportExecutionGrant[]

  @@index([operatorAccountId, status, expiresAt])
  @@index([targetAccountId, status, expiresAt])
  @@index([correlationId])
}

// Support Pilot S1 persists only case-control and sanitized diagnostic evidence.
// It is deliberately not a user-state or platform-command authority.
model SupportCase {
  id                     String                    @id @default(cuid())
  caseNumber             String                    @unique
  requestingOperatorId   String
  targetAccountId        String
  supportAccessRequestId String?                   @unique
  title                  String
  safeSummary            String
  status                 String                    @default("AWAITING_CONSENT")
  correlationId          String                    @unique
  openedAt               DateTime                  @default(now())
  closedAt               DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  requestingOperator     UserAccount               @relation("SupportCaseOperator", fields: [requestingOperatorId], references: [id], onDelete: Restrict)
  targetAccount          UserAccount               @relation("SupportCaseTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  supportAccessRequest   SupportAccessRequest?     @relation("SupportCaseAccessRequest", fields: [supportAccessRequestId], references: [id], onDelete: SetNull)
  executionGrants        SupportExecutionGrant[]
  executionSessions      SupportExecutionSession[]

  @@index([requestingOperatorId, status, openedAt])
  @@index([targetAccountId, status, openedAt])
}

model SupportExecutionGrant {
  id                    String                    @id @default(cuid())
  supportCaseId         String
  parentSupportGrantId  String
  operatorAccountId     String
  targetAccountId       String
  grantedScopes         String
  dataClasses           String
  riskCeiling           String                    @default("READ_ONLY")
  status                String                    @default("ACTIVE")
  issuedAt              DateTime                  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  correlationId         String                    @unique
  createdAt             DateTime                  @default(now())
  supportCase           SupportCase               @relation(fields: [supportCaseId], references: [id], onDelete: Restrict)
  parentSupportGrant    SupportAccessGrant        @relation(fields: [parentSupportGrantId], references: [id], onDelete: Restrict)
  operator              UserAccount               @relation("SupportExecutionGrantOperator", fields: [operatorAccountId], references: [id], onDelete: Restrict)
  targetAccount         UserAccount               @relation("SupportExecutionGrantTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  sessions              SupportExecutionSession[]

  @@index([supportCaseId, status, expiresAt])
  @@index([operatorAccountId, targetAccountId, status, expiresAt])
}

model SupportExecutionSession {
  id                       String                  @id @default(cuid())
  supportCaseId            String
  supportExecutionGrantId  String?
  operatorAccountId        String
  status                   String                  @default("RUNNING")
  queriedDomains           String                  @default("[]")
  dataClasses              String                  @default("[]")
  redactionCount           Int                     @default(0)
  deniedAccessCount        Int                     @default(0)
  denialCode               String?
  receiptDigest            String?
  startedAt                DateTime                @default(now())
  completedAt              DateTime?
  correlationId            String                  @unique
  createdAt                DateTime                @default(now())
  supportCase              SupportCase             @relation(fields: [supportCaseId], references: [id], onDelete: Restrict)
  supportExecutionGrant    SupportExecutionGrant?  @relation(fields: [supportExecutionGrantId], references: [id], onDelete: SetNull)
  operator                 UserAccount             @relation("SupportExecutionSessionOperator", fields: [operatorAccountId], references: [id], onDelete: Restrict)
  observations             SupportObservation[]
  evidenceReferences       SupportEvidenceReference[]
  findings                 SupportFinding[]
  diagnosis                SupportDiagnosis?
  repairProposals          SupportRepairProposal[]

  @@index([supportCaseId, startedAt])
  @@index([supportExecutionGrantId, startedAt])
}

model SupportObservation {
  id                       String                    @id @default(cuid())
  supportExecutionSessionId String
  domain                   String
  scope                    String
  dataClassification       String
  sourceType               String
  sourceId                 String
  sourceDigest             String
  safeSummary              String
  observedAt               DateTime                  @default(now())
  executionSession         SupportExecutionSession   @relation(fields: [supportExecutionSessionId], references: [id], onDelete: Cascade)
  evidenceReferences       SupportEvidenceReference[]

  @@index([supportExecutionSessionId, domain, observedAt])
}

model SupportEvidenceReference {
  id                       String                  @id @default(cuid())
  supportExecutionSessionId String
  supportObservationId     String?
  sourceDomain             String
  sourceReference          String
  dataClassification       String
  digest                   String
  sanitizedExcerpt         String
  redacted                 Boolean                 @default(false)
  observedAt               DateTime                @default(now())
  executionSession         SupportExecutionSession @relation(fields: [supportExecutionSessionId], references: [id], onDelete: Cascade)
  observation              SupportObservation?    @relation(fields: [supportObservationId], references: [id], onDelete: SetNull)
  findingLinks             SupportFindingEvidence[]

  @@index([supportExecutionSessionId, sourceDomain, observedAt])
}

model SupportFinding {
  id                       String                  @id @default(cuid())
  supportExecutionSessionId String
  code                     String
  summary                  String
  confidence               String
  uncertainty              String
  status                   String                  @default("OPEN")
  createdAt                DateTime                @default(now())
  executionSession         SupportExecutionSession @relation(fields: [supportExecutionSessionId], references: [id], onDelete: Cascade)
  evidenceLinks            SupportFindingEvidence[]

  @@index([supportExecutionSessionId, confidence])
}

model SupportFindingEvidence {
  supportFindingId          String
  supportEvidenceReferenceId String
  supportFinding            SupportFinding          @relation(fields: [supportFindingId], references: [id], onDelete: Cascade)
  supportEvidenceReference  SupportEvidenceReference @relation(fields: [supportEvidenceReferenceId], references: [id], onDelete: Cascade)

  @@id([supportFindingId, supportEvidenceReferenceId])
}

model SupportDiagnosis {
  id                       String                  @id @default(cuid())
  supportExecutionSessionId String                 @unique
  primaryCause             String
  confidence               String
  uncertainty              String
  unresolvedQuestions      String                  @default("[]")
  evidenceDigest           String
  createdAt                DateTime                @default(now())
  executionSession         SupportExecutionSession @relation(fields: [supportExecutionSessionId], references: [id], onDelete: Cascade)
}

model SupportRepairProposal {
  id                       String                  @id @default(cuid())
  supportExecutionSessionId String
  proposalType             String
  summary                  String
  requiredUserConsent      Boolean                 @default(false)
  requiresAdministrator    Boolean                 @default(true)
  state                    String                  @default("INFORMATION_ONLY")
  createdAt                DateTime                @default(now())
  executionSession         SupportExecutionSession @relation(fields: [supportExecutionSessionId], references: [id], onDelete: Cascade)

  @@index([supportExecutionSessionId, state])
}

model WayfarerMigrationRecord {
  id         String       @id @default(cuid())
  sourceType String
  sourceId   String       @unique
  accountId  String?
  status     String
  detail     String       @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  account    UserAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([status, sourceType])
}

model GameMasterSession {
  id        String         @id
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime       @default(now())
  user      GameMasterUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Chapter {
  id                  String         @id @default(cuid())
  campaignId          String
  ordinal             Int
  state               String         @default("LOCKED")
  contentId           String
  revealedAt          DateTime?
  solvedAt            DateTime?
  safeTeaser          String?
  relatedMapKey       String?
  relatedArtifactKey  String?
  relatedSideQuestKey String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  campaign            Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content             ChapterContent @relation(fields: [contentId], references: [id])
  clues               Clue[]
  hints               Hint[]

  @@unique([campaignId, ordinal])
  @@index([campaignId, state])
}

model ChapterContent {
  id              String    @id @default(cuid())
  version         Int       @default(1)
  title           String
  narrative       String
  objective       String
  developmentOnly Boolean   @default(true)
  createdAt       DateTime  @default(now())
  chapters        Chapter[]
}

model Clue {
  id        String  @id @default(cuid())
  chapterId String
  ordinal   Int
  body      String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, ordinal])
}

model Hint {
  id         String    @id @default(cuid())
  chapterId  String
  ordinal    Int
  body       String
  releasedAt DateTime?
  chapter    Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, ordinal])
}

model Artifact {
  id                   String          @id @default(cuid())
  campaignId           String
  key                  String
  name                 String
  description          String
  safeName             String?
  state                String          @default("UNKNOWN")
  category             String          @default("RELIC")
  discoveryText        String?
  silhouetteLabel      String?
  displayX             Float           @default(50)
  displayY             Float           @default(50)
  assemblyGroup        String?
  assemblyPosition     String?
  connectedArtifactKey String?
  chapterOrdinal       Int?
  campaign             Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  awards               ArtifactAward[]

  @@unique([campaignId, key])
}

model ArtifactAward {
  id         String   @id @default(cuid())
  campaignId String
  artifactId String
  eventId    String?  @unique
  awardedAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, artifactId])
}

model SideQuest {
  id                String               @id @default(cuid())
  campaignId        String
  key               String
  title             String
  state             String               @default("UNDISCOVERED")
  safeTeaser        String?
  description       String?
  rewardType        String?
  rewardLabel       String?
  completionSummary String?
  chapterOrdinal    Int?
  mapLocationKey    String?
  artifactKey       String?
  completedAt       DateTime?
  campaign          Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  objectives        SideQuestObjective[]

  @@unique([campaignId, key])
}

model SideQuestObjective {
  id          String    @id @default(cuid())
  sideQuestId String
  ordinal     Int
  body        String
  complete    Boolean   @default(false)
  sideQuest   SideQuest @relation(fields: [sideQuestId], references: [id], onDelete: Cascade)

  @@unique([sideQuestId, ordinal])
}

model JournalEntry {
  id             String    @id @default(cuid())
  campaignId     String
  title          String
  body           String
  kind           String    @default("ANNOTATION")
  eventId        String?   @unique
  chapterOrdinal Int?
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, releasedAt])
}

model MapLocation {
  id             String    @id @default(cuid())
  campaignId     String
  key            String
  name           String
  safeLabel      String?
  regionLabel    String
  locationType   String    @default("STORY")
  state          String    @default("UNKNOWN")
  description    String?
  exactness      String    @default("APPROXIMATE")
  chapterOrdinal Int?
  sideQuestKey   String?
  x              Float
  y              Float
  mobileX        Float?
  mobileY        Float?
  revealedAt     DateTime?
  completedAt    DateTime?
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
}

model MapRoute {
  id         String    @id @default(cuid())
  campaignId String
  key        String
  fromKey    String
  toKey      String
  ordinal    Int
  state      String    @default("HIDDEN")
  annotation String?
  revealedAt DateTime?
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
  @@index([campaignId, ordinal])
}

model ProgressEvent {
  id              String   @id @default(cuid())
  campaignId      String
  type            String
  payload         String
  actor           String
  sequence        Int
  version         Int      @default(1)
  releaseAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  reversesEventId String?
  supersededById  String?
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
  @@index([campaignId, releaseAt])
}

model CampaignSnapshot {
  id         String   @id @default(cuid())
  campaignId String
  sequence   Int
  version    Int      @default(1)
  state      String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
}

model AdminAuditLog {
  id            String          @id @default(cuid())
  campaignId    String
  userId        String?
  action        String
  metadata      String
  correlationId String?
  outcome       String          @default("SUCCEEDED")
  reason        String?
  createdAt     DateTime        @default(now())
  campaign      Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          GameMasterUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
}

model PreparedAction {
  id               String    @id @default(cuid())
  campaignId       String
  command          String
  targetKey        String?
  payload          String
  status           String    @default("PREPARED")
  expectedSequence Int
  scheduledFor     DateTime?
  preparedBy       String
  preparedAt       DateTime  @default(now())
  executedAt       DateTime?
  cancelledAt      DateTime?
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status, scheduledFor])
}

model CommandExecution {
  id               String    @id @default(cuid())
  campaignId       String
  idempotencyKey   String
  command          String
  expectedSequence Int
  correlationId    String
  status           String
  result           String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([campaignId, createdAt])
}

model AudioPreference {
