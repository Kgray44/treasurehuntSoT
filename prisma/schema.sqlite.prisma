  @@index([status, displayName])
  @@index([normalizedHandle, status])
}

model ProfileHandleHistory {
  id               String        @id @default(cuid())
  playerProfileId  String
  handle           String
  normalizedHandle String        @unique
  changedAt        DateTime      @default(now())
  releasedAt       DateTime?
  player           PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([playerProfileId, changedAt])
}

model ProfileMedia {
  id                 String         @id @default(cuid())
  profileId          String
  ownerAccountId     String?
  kind               String
  storageKey         String         @unique
  originalStorageKey String?        @unique
  mimeType           String
  originalMimeType   String?
  byteLength         Int
  originalByteLength Int?
  width              Int?
  height             Int?
  originalWidth      Int?
  originalHeight     Int?
  checksum           String?
  cropCenterX        Float          @default(0.5)
  cropCenterY        Float          @default(0.5)
  cropScale          Float          @default(1)
  cropAspect         Float          @default(1)
  sourceOrientation  Int            @default(1)
  rotation           Int            @default(0)
  processingState    String         @default("READY")
  scanState          String         @default("LOCAL_VALIDATED")
  replacesMediaId    String?
  altText            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  removedAt          DateTime?
  profile            PlayerProfile  @relation("ProfileMediaOwner", fields: [profileId], references: [id], onDelete: Cascade)
  account            UserAccount?   @relation(fields: [ownerAccountId], references: [id], onDelete: SetNull)
  replaces           ProfileMedia?  @relation("ProfileMediaReplacement", fields: [replacesMediaId], references: [id], onDelete: SetNull)
  replacements       ProfileMedia[] @relation("ProfileMediaReplacement")
  avatarFor          PlayerProfile? @relation("ProfileAvatar")
  bannerFor          PlayerProfile? @relation("ProfileBanner")

