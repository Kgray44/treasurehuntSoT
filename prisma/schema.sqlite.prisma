  id                          String                               @id @default(cuid())
  sourceProtectedMediaId      String
  sourcePrivateAssetObjectId  String
  derivativeObjectId          String
  sourceChecksum              String
  transformationPolicy        String
  transformationPolicyVersion Int
  purpose                     String
  mediaKind                   String
  outputMediaType             String
  outputByteLength            Int
  outputChecksum              String
  width                       Int?
  height                      Int?
  durationMilliseconds        Int?
  storageNamespace            String                               @default("derivatives")
  storageOpaqueReference      String                               @unique
  wrappedKeyReference         String?
  scanState                   String
  state                       String
  operationId                 String
  supersedesDerivativeId      String?
