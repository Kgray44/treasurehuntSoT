  ambientVolume       Float        @default(0.25)
  effectsVolume       Float        @default(0.55)
  motionMode          String       @default("SYSTEM")
  textScale           Float        @default(1)
  ambientEffects      Boolean      @default(true)
  textureIntensity    Float        @default(1)
  fullscreenPreferred Boolean      @default(false)
  updatedAt           DateTime     @updatedAt
  playerAccess        PlayerAccess @relation(fields: [playerAccessId], references: [id], onDelete: Cascade)
}

model ViewedContent {
  id             String       @id @default(cuid())
  playerAccessId String
  contentType    String
  contentKey     String
  viewedAt       DateTime     @default(now())
  playerAccess   PlayerAccess @relation(fields: [playerAccessId], references: [id], onDelete: Cascade)

  @@unique([playerAccessId, contentType, contentKey])
  @@index([playerAccessId, viewedAt])
}

model ContentVersion {
  id          String    @id @default(cuid())
  key         String
  version     Int
  checksum    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([key, version])
}

model SaveStateSnapshot {
  id         String   @id @default(cuid())
  campaignId String
  sequence   Int
  state      String
  reason     String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sequence])
}

model ViewedCeremony {
  id         String   @id @default(cuid())
  campaignId String
  deviceId   String
  eventId    String
  viewedAt   DateTime @default(now())

  @@unique([campaignId, deviceId, eventId])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  fingerprint String
  succeeded   Boolean
  createdAt   DateTime @default(now())

  @@index([fingerprint, createdAt])
}

// Chronicle Studio is deliberately additive. The original Campaign models above
// continue to power the existing Forever Treasure experience while authored tales
// use an immutable publish-and-session model.
model Chronicle {
  id                       String                       @id @default(cuid())
  slug                     String                       @unique
  title                    String
  subtitle                 String?
  shortDescription         String?
  longDescription          String?
  coverAssetId             String?
  theme                    String                       @default("CARTOGRAPHERS_TABLE")
  status                   String                       @default("DRAFT")
  visibility               String                       @default("PRIVATE")
  creatorId                String
  creatorAccountId         String?
  currentDraftRevisionId   String?
  latestPublishedVersionId String?
  forkedFromTaleId         String?
  forkedFromVersionId      String?
  playerCountMin           Int                          @default(1)
  playerCountMax           Int                          @default(4)
  estimatedDuration        Int?
  contentWarnings          String?
  sortOrder                Int                          @default(0)
  featured                 Boolean                      @default(false)
  archivedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  drafts                   TaleDraft[]
  versions                 PublishedTaleVersion[]
  assets                   TaleAsset[]
  collections              TaleAssetCollection[]
  locations                TaleLocation[]
  storyArtifacts           TaleArtifact[]
  sideQuests               TaleSideQuest[]
  sessions                 TaleSession[]
  privateImports           PrivateContentImport[]
  privateAssetReferences   PrivateAssetReference[]
  tideglassAnnotations     TideglassCreatorAnnotation[]
  creatorAccount           UserAccount?                 @relation("ChronicleCreatorAccount", fields: [creatorAccountId], references: [id], onDelete: SetNull)

  @@index([status, visibility, sortOrder])
  @@index([creatorId, updatedAt])
  @@index([creatorAccountId, updatedAt])
}

model TaleDraft {
  id                           String                             @id @default(cuid())
  taleId                       String
  revisionNumber               Int                                @default(1)
  basedOnPublishedVersionId    String?
  createdBy                    String
  createdByAccountId           String?
  autosaveVersion              Int                                @default(1)
  validationState              String                             @default("NOT_VALIDATED")
  validationSummary            String                             @default("{}")
  lastValidatedAt              DateTime?
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt
  tale                         Chronicle                          @relation(fields: [taleId], references: [id], onDelete: Cascade)
  chapters                     TaleChapter[]
  drydockValidationRuns        DrydockValidationRun[]
  drydockScenarios             DrydockScenario[]
  drydockScenarioSuites        DrydockScenarioSuite[]
  drydockScenarioSuiteEvidence DrydockScenarioSuiteEvidence[]
  drydockSimulationRuns        DrydockSimulationRun[]
  drydockCompatibilityRuns     DrydockCompatibilityRun[]
  drydockExternalEvidence      DrydockExternalEvidenceReference[]
  createdByAccount             UserAccount?                       @relation("TaleDraftAuthorAccount", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  drydockRuleWaivers           DrydockRuleWaiver[]
  reusableAuthoringUsages      ReusableAuthoringUsage[]

  @@unique([taleId, revisionNumber])
  @@index([taleId, updatedAt])
  @@index([createdByAccountId])
}

model DrydockValidationRun {
  id                  String    @id @default(cuid())
  draftId             String
  runId               String    @unique
  sourceChecksum      String
  sourceRevision      Int
  reportSchemaVersion Int
  ruleCatalogVersion  Int
  status              String
  proofCompleteness   String
  issueCount          Int
  issueDigest         String
  reportDigest        String
  report              String
  createdAt           DateTime  @default(now())
  draft               TaleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([sourceChecksum])
}

model DrydockRuleWaiver {
  id                    String      @id
  draftId               String
  issueId               String
  ruleCode              String
  ruleVersion           Int
  sourceChecksum        String
  sourceRevision        Int
  rationale             String
  scope                 String
  authorizedByAccountId String
  authorizedRole        String
  createdAt             DateTime    @default(now())
  expiresAt             DateTime?
  reviewCondition       String?
  carryForwardPolicy    String      @default("DO_NOT_CARRY")
  revokedAt             DateTime?
  auditReference        String?
  draft                 TaleDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  authorizedByAccount   UserAccount @relation("DrydockWaiverAuthor", fields: [authorizedByAccountId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@index([issueId, sourceChecksum])
  @@index([authorizedByAccountId, createdAt])
}

model DrydockScenario {
  id              String                    @id @default(cuid())
  draftId         String
  scenarioId      String
  title           String
  currentRevision Int                       @default(1)
  archivedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  draft           TaleDraft                 @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisions       DrydockScenarioRevision[]

  @@unique([draftId, scenarioId])
  @@index([draftId, archivedAt, updatedAt])
}

model DrydockScenarioRevision {
  id                    String                       @id @default(cuid())
  scenarioRecordId      String
  revision              Int
  sourceChecksum        String
  scenarioSchemaVersion Int
  scenarioDigest        String
  scenario              String
  createdAt             DateTime                     @default(now())
  scenarioRecord        DrydockScenario              @relation(fields: [scenarioRecordId], references: [id], onDelete: Cascade)
  suiteMembers          DrydockScenarioSuiteMember[]
  simulationRuns        DrydockSimulationRun[]

  @@unique([scenarioRecordId, revision])
  @@index([sourceChecksum, createdAt])
}

model DrydockScenarioSuite {
  id             String                         @id @default(cuid())
  draftId        String
  suiteId        String
  title          String
  sourceChecksum String
  revision       Int                            @default(1)
  archivedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  draft          TaleDraft                      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  members        DrydockScenarioSuiteMember[]
  launchEvidence DrydockScenarioSuiteEvidence[]

  @@unique([draftId, suiteId])
  @@index([draftId, archivedAt, updatedAt])
}

model DrydockScenarioSuiteMember {
  id                 String                  @id @default(cuid())
  suiteRecordId      String
  scenarioRevisionId String
  orderIndex         Int
  createdAt          DateTime                @default(now())
  suiteRecord        DrydockScenarioSuite    @relation(fields: [suiteRecordId], references: [id], onDelete: Cascade)
  scenarioRevision   DrydockScenarioRevision @relation(fields: [scenarioRevisionId], references: [id], onDelete: Restrict)

  @@unique([suiteRecordId, scenarioRevisionId])
  @@unique([suiteRecordId, orderIndex])
  @@index([scenarioRevisionId])
}

/**
 * Immutable Phase 4 binding of an exact Suite revision to existing Scenario receipts.
 */
model DrydockScenarioSuiteEvidence {
  id                         String               @id @default(cuid())
  draftId                    String
  suiteRecordId              String
  suiteRevision              Int
  sourceChecksum             String
  schemaRegistryVersion      Int
  ruleCatalogVersion         Int
  runtimeAdapterVersion      String
  requiredSuitePolicyVersion String
  compatibilityPolicyVersion String
  runIds                     String
  coverageDigest             String
  proofStatus                String
  createdAt                  DateTime             @default(now())
  draft                      TaleDraft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  suiteRecord                DrydockScenarioSuite @relation(fields: [suiteRecordId], references: [id], onDelete: Cascade)

  @@index([draftId, sourceChecksum, createdAt])
  @@index([suiteRecordId, suiteRevision, createdAt])
  @@index([sourceChecksum, proofStatus])
}

model DrydockSimulationRun {
  id                      String                   @id @default(cuid())
  draftId                 String
  runId                   String                   @unique
  scenarioRevisionId      String?
  sourceChecksum          String
  sourceRevision          Int
  sourceGitSha            String                   @default("UNRESOLVED")
  engineVersion           String
  adapterVersion          String
  scenarioSchemaVersion   Int                      @default(1)
  faultCatalogVersion     String                   @default("drydock-fault-catalog-v1")
  status                  String
  resultDigest            String?
  coverageDigest          String?
  sourceSnapshot          String
  result                  String                   @default("{}")
  trace                   String                   @default("[]")
  checkpoint              String                   @default("{}")
  completedInputs         Int                      @default(0)
  cancellationRequestedAt DateTime?
  leaseToken              String?
  leaseExpiresAt          DateTime?
  startedAt               DateTime                 @default(now())
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  draft                   TaleDraft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  scenarioRevision        DrydockScenarioRevision? @relation(fields: [scenarioRevisionId], references: [id], onDelete: SetNull)

  @@index([draftId, createdAt])
  @@index([sourceChecksum, status])
  @@index([scenarioRevisionId, createdAt])
  @@index([leaseExpiresAt])
}

model DrydockCompatibilityRun {
  id             String    @id @default(cuid())
  draftId        String
  runId          String    @unique
  sourceChecksum String
  policyVersion  String
  status         String
  digest         String
  result         String
  createdAt      DateTime  @default(now())
  draft          TaleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([sourceChecksum, status])
}

model DrydockExternalEvidenceReference {
  id              String    @id @default(cuid())
  draftId         String
  providerId      String
  providerVersion String
  evidenceKind    String
  sourceChecksum  String
  status          String
  safeSummary     String
  sourceReference String?
  checkedAt       DateTime
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  draft           TaleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, providerId, providerVersion, evidenceKind, sourceChecksum])
  @@index([draftId, sourceChecksum])
  @@index([status, expiresAt])
}

model TaleChapter {
  id                String       @id @default(cuid())
  draftRevisionId   String
  title             String
  subtitle          String?
  description       String?
  orderIndex        Int
  coverAssetId      String?
  estimatedDuration Int?
  entryBlockId      String?
  completionBlockId String?
  isOptional        Boolean      @default(false)
  metadata          String       @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  draft             TaleDraft    @relation(fields: [draftRevisionId], references: [id], onDelete: Cascade)
  blocks            StoryBlock[]

  @@unique([draftRevisionId, orderIndex])
  @@index([draftRevisionId])
}

model StoryBlock {
  id            String            @id @default(cuid())
  chapterId     String
  blockType     String
  title         String
  internalLabel String?
  orderIndex    Int
  configuration String            @default("{}")
  presentation  String            @default("{}")
  completion    String            @default("{}")
  nextBlockId   String?
  creatorNotes  String?
  isEnabled     Boolean           @default(true)
  schemaVersion Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  chapter       TaleChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  outgoing      BlockConnection[] @relation("BlockConnectionSource")
  incoming      BlockConnection[] @relation("BlockConnectionTarget")

  @@unique([chapterId, orderIndex])
  @@index([chapterId, blockType])
}

model BlockConnection {
  id                  String     @id @default(cuid())
  sourceBlockId       String
  targetBlockId       String
  connectionType      String     @default("DEFAULT")
  conditionExpression String?
  label               String?
  orderIndex          Int        @default(0)
  createdAt           DateTime   @default(now())
  source              StoryBlock @relation("BlockConnectionSource", fields: [sourceBlockId], references: [id], onDelete: Cascade)
  target              StoryBlock @relation("BlockConnectionTarget", fields: [targetBlockId], references: [id], onDelete: Cascade)

  @@unique([sourceBlockId, targetBlockId, connectionType])
  @@index([targetBlockId])
}

model ReusableAuthoringItem {
  id                   String                         @id @default(cuid())
  ownerAccountId       String
  kind                 String
  name                 String
  description          String                         @default("")
  tags                 String                         @default("[]")
  status               String                         @default("ACTIVE")
  currentVersionNumber Int                            @default(1)
  archivedAt           DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  owner                UserAccount                    @relation("ReusableAuthoringItemOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  versions             ReusableAuthoringItemVersion[]
  usages               ReusableAuthoringUsage[]

  @@index([ownerAccountId, status, updatedAt])
  @@index([ownerAccountId, kind, updatedAt])
}

model ReusableAuthoringItemVersion {
  id            String                @id @default(cuid())
  itemId        String
  versionNumber Int
  envelope      String
  checksum      String
  createdAt     DateTime              @default(now())
  item          ReusableAuthoringItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  usages        ReusableAuthoringUsage[]

  @@unique([itemId, versionNumber])
  @@index([checksum])
}

model ReusableAuthoringUsage {
  id                 String                       @id @default(cuid())
  draftId            String
  itemId             String
  versionId          String
  sourceKind         String
  insertedBlockIds   String                       @default("[]")
  insertedChapterIds String                       @default("[]")
  provenance         String                       @default("{}")
  createdAt          DateTime                     @default(now())
  draft              TaleDraft                    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  item               ReusableAuthoringItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  version            ReusableAuthoringItemVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@index([itemId, createdAt])
  @@index([versionId])
}

model PublishedTaleVersion {
  id                         String                       @id @default(cuid())
  taleId                     String
  versionNumber              Int
  versionLabel               String
  publishedAt                DateTime                     @default(now())
  publishedBy                String
  publishedByAccountId       String?
  releaseNotes               String?
  contentSnapshot            String
  schemaVersion              Int                          @default(1)
  checksum                   String
  isCurrent                  Boolean                      @default(true)
  tale                       Chronicle                    @relation(fields: [taleId], references: [id], onDelete: Cascade)
  sessions                   TaleSession[]
  publishedByAccount         UserAccount?                 @relation("PublishedVersionAuthorAccount", fields: [publishedByAccountId], references: [id], onDelete: SetNull)
  communityReleases          CommunityRelease[]           @relation("CommunityReleaseSource")
  chronicleRecords           PlayerChronicleRecord[]
  artifactRecords            PlayerArtifactRecord[]
  assemblyInstances          PlayerArtifactAssembly[]
  tideglassSourceAnnotations TideglassCreatorAnnotation[] @relation("TideglassSourceEdition")
  tideglassTargetAnnotations TideglassCreatorAnnotation[] @relation("TideglassTargetEdition")
  drydockPublishingEvidence  DrydockPublishingEvidence?

  @@unique([taleId, versionNumber])
  @@unique([taleId, checksum])
  @@index([taleId, isCurrent])
  @@index([publishedByAccountId])
}

model DrydockPublishingEvidence {
  id                         String               @id @default(cuid())
  publishedVersionId         String               @unique
  sourceChecksum             String
  schemaVersion              Int
  schemaRegistryVersion      Int
  ruleCatalogVersion         Int
  validationRunId            String
  requiredSuitePolicyVersion String
  compatibilityPolicyVersion String
  compatibilityDigest        String
  externalEvidenceDigest     String
  evidence                   String
  digest                     String               @unique
  createdAt                  DateTime             @default(now())
  publishedVersion           PublishedTaleVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)

  @@index([sourceChecksum])
  @@index([createdAt])
}

model TideglassCreatorAnnotation {
  id                      String                      @id @default(cuid())
  annotationKey           String
  revision                Int
  chronicleId             String
  sourceEditionId         String
  sourceEditionChecksum   String
  targetEditionId         String
  targetEditionChecksum   String
  comparisonPolicyVersion String
  scopeType               String
  category                String?
  changeRecordId          String?
  annotationKind          String
  headline                String?
  body                    String?
  spoilerLevel            String
  highlighted             Boolean                     @default(false)
  replayGuidance          String                      @default("NO_RECOMMENDATION")
  createdByAccountId      String
  createdAt               DateTime                    @default(now())
  supersedesAnnotationId  String?                     @unique
  state                   String                      @default("ACTIVE")
  idempotencyKey          String?
  chronicle               Chronicle                   @relation(fields: [chronicleId], references: [id], onDelete: Restrict)
  sourceEdition           PublishedTaleVersion        @relation("TideglassSourceEdition", fields: [sourceEditionId], references: [id], onDelete: Restrict)
  targetEdition           PublishedTaleVersion        @relation("TideglassTargetEdition", fields: [targetEditionId], references: [id], onDelete: Restrict)
  createdByAccount        UserAccount                 @relation("TideglassAnnotationAuthor", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  supersedes              TideglassCreatorAnnotation? @relation("TideglassAnnotationRevision", fields: [supersedesAnnotationId], references: [id], onDelete: Restrict)
  supersededBy            TideglassCreatorAnnotation? @relation("TideglassAnnotationRevision")

  @@unique([annotationKey, revision])
  @@unique([createdByAccountId, idempotencyKey])
  @@index([chronicleId, sourceEditionId, targetEditionId, createdAt])
  @@index([changeRecordId])
  @@index([createdByAccountId, createdAt])
}

model TaleAsset {
