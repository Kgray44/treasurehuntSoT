  scope                String         @default("GENERAL_MEDIA")
  state                String         @default("PENDING")
  historicalLabel      String?
  requestedAt          DateTime       @default(now())
  decidedAt            DateTime?
  requestedByProfileId String?
  correlationId        String?
  grantedAt            DateTime?
  revokedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  keepsake             VoyageKeepsake @relation(fields: [keepsakeId], references: [id], onDelete: Cascade)
  participant          PlayerProfile  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([keepsakeId, participantId, scope])
  @@index([participantId, state])
