/// Phase 4 protected-media metadata.  It references an existing private object;
/// neither a browser route nor a consuming project receives that object's storage key.
model ProtectedMedia {
  id                           String                           @id @default(cuid())
  ownerAccountId               String
  ownerProfileId               String?
  sourcePrivateAssetObjectId   String
  mediaKind                    String
  declaredMediaType            String
  detectedMediaType            String
  byteLength                   Int
  sha256                       String
  scanState                    String
  availabilityState            String                           @default("AVAILABLE")
  privacyClassification        String                           @default("PRIVATE")
  originalFilenameSafeSnapshot String?
  accessibilityDescription     String?
  withdrawnAt                  DateTime?
  archivedAt                   DateTime?
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt
  sourceObject                 PrivateAssetObject               @relation("ProtectedMediaSourceObject", fields: [sourcePrivateAssetObjectId], references: [id], onDelete: Restrict)
  associations                 ProtectedMediaAssociation[]
  consentAssertions            ProtectedMediaConsentAssertion[]
  derivatives                  ProtectedMediaDerivative[]
  grants                       ProtectedMediaGrant[]
  withdrawals                  ProtectedMediaWithdrawal[]

  @@unique([sourcePrivateAssetObjectId, ownerAccountId])
  @@index([ownerAccountId, createdAt])
  @@index([scanState, availabilityState])
}

