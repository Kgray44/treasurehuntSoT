// Wayfarer-owned, person-level projections. Source Voyage identifiers remain
// scalar so reconciliation never needs to write or retain mutable One Voyage rows.
model PlayerArtifactRecord {
  id                       String                         @id @default(cuid())
  playerProfileId          String
  sourcePlaythroughId      String
  sourceGrantEventId       String
  sourceGrantSequence      Int
  sourceBlockId            String?
  publishedVersionId       String
  publishedVersionChecksum String
  chronicleTitleSnapshot   String
  artifactDefinitionId     String
  artifactNameSnapshot     String
  artifactTypeSnapshot     String                         @default("ARTIFACT")
  representationSnapshot   String                         @default("FALLBACK")
  collectionKeySnapshot    String?
  assemblyKeySnapshot      String?
  componentRoleSnapshot    String?
  recipientPolicy          String
  recipientEvidence        String                         @default("{}")
  ownershipState           String
  custody                  String                         @default("PERSONAL")
  recordStatus             String                         @default("ACTIVE")
  discoveredAt             DateTime?
  grantedAt                DateTime?
  witnessedAt              DateTime?
  revokedAt                DateTime?
  archivedAt               DateTime?
  correctedAt              DateTime?
  correctionReason         String?
  sourceFingerprint        String
  lastDerivedAt            DateTime                       @default(now())
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  player                   PlayerProfile                  @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  publishedVersion         PublishedTaleVersion           @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)
  personalization          PlayerArtifactPersonalization?
  displayItems             ArtifactDisplayItem[]
  contributions            PlayerArtifactContribution[]

  @@unique([playerProfileId, sourceGrantEventId])
  @@index([playerProfileId, recordStatus, grantedAt])
  @@index([playerProfileId, ownershipState, artifactDefinitionId])
  @@index([sourcePlaythroughId, sourceGrantSequence])
}

model PlayerArtifactPersonalization {
  id                String               @id @default(cuid())
  artifactRecordId  String               @unique
  favorite          Boolean              @default(false)
  privateNote       String?
  chronicleMemoryId String?
  visibility        String               @default("ONLY_ME")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  artifact          PlayerArtifactRecord @relation(fields: [artifactRecordId], references: [id], onDelete: Cascade)
