{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyagewright.local/schemas/project-trim/mscp-packet-v2.schema.json",
  "title": "Project Trim Minimum Sufficient Context Packet v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "packetType",
    "task",
    "sourceIdentity",
    "scope",
    "authority",
    "priorPlateau",
    "ownership",
    "sourceSlice",
    "schemaSlice",
    "verificationSliceContract",
    "dependencySlice",
    "mainDelta",
    "knownRiskDetails",
    "expansionPolicy",
    "confidenceLevel",
    "staleness",
    "generator",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "packetType": { "const": "MINIMUM_SUFFICIENT_CONTEXT_PACKET" },
    "task": {
      "type": "object",
      "required": ["id", "taskClass", "executionProfile"]
    },
    "sourceIdentity": {
      "type": "object",
      "required": ["originMainSha", "originMainTreeSha", "headSha", "headTreeSha", "worktree", "dirtyState"]
    },
    "scope": {
      "type": "object",
      "required": ["objective", "nonGoals", "completionContract", "locallyAttainableBoundary"]
    },
    "authority": {
      "type": "object",
      "required": ["slices", "excluded", "conflicts", "confidence"]
    },
    "sourceSlice": { "type": "array" },
    "confidenceLevel": {
      "enum": ["EXACT", "BOUNDED", "COARSE", "UNKNOWN"]
    },
    "staleness": {
      "type": "object",
      "required": ["state", "affectedSlices", "targetedRegenerationSupported"],
      "properties": {
        "state": {
          "enum": ["FRESH", "PARTIALLY_STALE", "STALE", "CONFLICTED", "UNKNOWN"]
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["normalization", "sectionBindings", "semanticDigest"]
    }
  }
}
