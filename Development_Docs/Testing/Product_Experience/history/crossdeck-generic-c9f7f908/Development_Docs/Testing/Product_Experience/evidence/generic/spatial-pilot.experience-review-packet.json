{
  "objective": "Use a coherent blue Spatial Studio, preserve the scene while opening assistance, and return to the Creator Library",
  "contract": {
    "id": "spatial-pilot.experience",
    "name": "Synthetic Spatial Chronicle publication, multi-device adventure and gated owner trials",
    "authority": "one-voyage",
    "owners": ["spatial-pilot", "one-voyage", "project-crossdeck", "reach"],
    "critical": true,
    "experienceIntent": {
      "objective": "Create a spatial clue and understand the experience a Player will receive",
      "visibleOutcome": "Published scenes reach a representative Player Lens with truthful capability tiers and accessible fallback",
      "integrationOwner": "Parallax Creator-to-Player experience integration",
      "systems": ["project-parallax", "project-crossdeck", "one-voyage"],
      "sourcePaths": [
        "src/parallax",
        "src/components/studio/parallax",
        "src/components/player/parallax",
        "src/spatial-pilot"
      ],
      "persona": "A Creator or Player completing the named human objective",
      "entryPoint": "CONTEXTUAL_VOYAGE_OR_STUDIO_ENTRY_REQUIRED",
      "devices": ["DESKTOP", "MOBILE"],
      "accessibility": "Provide keyboard/touch operation and a meaningful supported alternate experience.",
      "baselineDebt": [
        {
          "id": "PE-DEBT-PARALLAX-PLAYER",
          "fingerprint": "94e3716d8ae26d5986e855cd4996b36d0edfbce1a2778937ba23548cc3506834",
          "status": "OWNER_REPORTED_BASELINE_REQUIRES_RENDERED_CONFIRMATION",
          "repairOwner": "Spatial Experience Refit",
          "repairPath": "Development_Docs/Testing/Product_Experience/Spatial_Refit_Readiness.md",
          "ledger": "Development_Docs/Projects/Project_Homeport/Homeport_Nonconformity_Ledger.csv",
          "deficiency": "Creator preview and Player entity controls do not by themselves establish one coherent spatial clue experience."
        }
      ],
      "limitation": "This campaign defines the required experience and tracks existing debt; it does not implement Spatial Experience Refit."
    },
    "experience": {
      "persona": "A Creator authoring a real spatial scene with assistance and ordinary editor controls",
      "objective": "Use a coherent blue Spatial Studio, preserve the scene while opening assistance, and return to the Creator Library",
      "visibleOutcome": "Light appearance covers the authoring shell and synthetic environment; overlay assistance preserves the viewport and canonical authoring controls",
      "integrationOwner": "Parallax Creator-to-Player experience integration",
      "systems": ["project-parallax", "project-crossdeck", "one-voyage"],
      "sourcePaths": ["src/components/studio/parallax", "src/app/studio/parallax"],
      "projectionPaths": ["src/parallax"],
      "entryPoint": "/studio/library",
      "states": ["EDITOR_READY", "ASSISTANT_READY", "ASSISTANT_DOCKED", "RETURNED"],
      "devices": ["DESKTOP", "MOBILE"],
      "roles": ["CREATOR"],
      "accessibility": "Keyboard entry and visible focus reach assistance, docking and return; readable themes and reduced motion retain meaning.",
      "fallback": "Without a configured credential or AI allowance, ordinary authoring and guided placement controls remain available.",
      "navigation": "Creator Library opens Spatial Studio; assistance overlays the scene; closing and returning restores the ordinary Creator Library.",
      "designTarget": "Use an entirely light or dark blue authoring workspace with separated title/status, clear populated dock sections, and an assistant overlay that never shrinks the canvas.",
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted public entry establishes hierarchy and a coherent shell around distinct role destinations.",
          "preserve": "Visible account access, clear destinations, cinematic composition and a usable reduced-motion equivalent."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted constrained gateway keeps the same destinations and account access.",
          "preserve": "Mobile task hierarchy, readable controls and contextual navigation."
        }
      ],
      "homeportScreenIds": ["screen-page-studio-library", "screen-page-studio"],
      "homeportJourneyIds": ["B"],
      "browserTests": [
        "tests/e2e/parallax-owner-refinements.spec.ts",
        "tests/e2e/parallax-assistant-presentation.spec.ts",
        "tests/e2e/parallax-spatial-assistant.spec.ts",
        "tests/e2e/parallax-workstation.spec.ts"
      ],
      "fixtureProfile": "generic",
      "recordingRequired": true,
      "limitations": [
        "This bounded Creator correction does not claim a Player Lens refit, physical touch/AR acceptance, live model corpus qualification, or owner product acceptance. The protected spatial-pilot experienceIntent and its owner-reported Player debt remain unchanged."
      ],
      "roleSetup": {
        "CREATOR": {
          "entryPoint": "/sign-in?returnTo=%2Fstudio%2Flibrary",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "parallax-review-creator@example.test"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Parallax-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            }
          ],
          "witness": {
            "role": "heading",
            "name": "Voyagewright Studio",
            "text": "Voyagewright Studio"
          }
        }
      },
      "continuity": {
        "objective": "The same authenticated Creator identity survives the Studio entry, assistance review and return to the canonical Chronicle library.",
        "checks": [
          {
            "id": "creator-identity",
            "role": "button",
            "name": "Synthetic Parallax Creator",
            "attribute": "aria-label"
          }
        ]
      },
      "motion": {
        "measurement": "Visible keyboard action to rendered editor or assistance feedback",
        "feedbackBudgetMs": 3000
      },
      "journeys": [
        {
          "id": "creator-assistance-and-return",
          "roles": ["CREATOR"],
          "outcome": "A Creator enters the actual editor, opens and docks contextual assistance, and returns to the same Creator library",
          "steps": [
            {
              "action": "click",
              "role": "link",
              "name": "Spatial Studio"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "text": "Ask Parallax",
              "path": "/studio/parallax",
              "state": "EDITOR_READY",
              "kind": "outcome",
              "meaning": "The natural Creator Library entry opens the usable spatial editing workspace with scene and contextual authoring actions.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Ask Parallax"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Spatial Assistant",
              "text": "Spatial Assistant",
              "path": "/studio/parallax",
              "state": "ASSISTANT_READY",
              "kind": "outcome",
              "meaning": "The assistance action opens a usable contextual idea composer and review area alongside the actual scene.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Dock assistance"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Ask Parallax workspace",
              "text": "Float assistance",
              "path": "/studio/parallax",
              "state": "ASSISTANT_DOCKED",
              "kind": "outcome",
              "meaning": "Docking attaches contextual assistance over the existing scene while exposing an explicit return to floating assistance.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Close assistance"
            },
            {
              "action": "click",
              "role": "link",
              "name": "← Creator Studio"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Voyagewright Studio",
              "text": "Voyagewright Studio",
              "path": "/studio/library",
              "state": "RETURNED",
              "returnPath": true
            }
          ]
        }
      ]
    }
  },
