            },
            {
              "action": "click",
              "role": "button",
              "name": "Journal companion"
            }
          ],
          "witness": {
            "role": "region",
            "name": "Journal companion",
            "text": "The harbour falls quiet behind you."
          }
        }
      },
      "journeys": [
        {
          "id": "companion-context-exit-return",
          "roles": ["PLAYER"],
          "outcome": "An authorized Player exits immersive companion presentation through visible Homeport context controls, finds the current adventure and returns to the same Voyage",
          "steps": [
            {
              "action": "assert",
              "role": "region",
              "name": "Journal companion",
              "text": "The harbour falls quiet behind you.",
              "state": "COMPANION_READY"
            },
            {
              "action": "assert",
              "role": "navigation",
