              "name": "Open on this device"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Journal companion"
            }
          ],
          "witness": {
            "role": "region",
            "name": "Journal companion",
            "text": "The harbour falls quiet behind you."
          }
        }
      },
      "journeys": [
        {
          "id": "companion-purpose-return",
