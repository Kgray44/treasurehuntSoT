{
  "objective": "Compare daily requests and costs, then inspect a user allowance through the normal People search",
  "contract": {
    "id": "admiralty.phase1.registry",
    "name": "Living capability-floor registry",
    "authority": "project-admiralty",
    "owners": [
      "project-admiralty"
    ],
    "critical": true,
    "experience": {
      "persona": "An authorized Admiralty operator observing daily AI spending and existing account allowances",
      "objective": "Compare daily requests and costs, then inspect a user allowance through the normal People search",
      "visibleOutcome": "A selectable daily chart distinguishes requests, settled cost and accounted exposure; per-user controls remain in the existing People dossier",
      "integrationOwner": "Admiralty AI usage experience integration",
      "systems": [
        "project-admiralty"
      ],
      "sourcePaths": [
        "src/components/admiralty/AIQuotaConsole.tsx",
        "src/components/admiralty/AIQuotaConsole.module.css",
        "src/components/admiralty/AIQuotaUserPanel.tsx",
        "src/app/admin/ai-usage",
        "src/app/admin/people",
        "src/components/admiralty/AIQuotaOverrides.tsx",
        "src/styles/admiralty.css"
      ],
      "projectionPaths": [
        "src/parallax/ai-quota-projections.ts"
      ],
      "entryPoint": "/admin/ai-usage",
      "states": [
        "SETTLED_CHART",
        "ACCOUNTED_CHART",
        "RETURNED",
        "DOSSIER_READY",
        "PEOPLE_RETURNED"
      ],
      "devices": [
        "DESKTOP",
        "MOBILE"
      ],
      "roles": [
        "ADMINISTRATOR"
      ],
      "accessibility": "A labeled keyboard-operable metric selector and exact daily table preserve access beyond visual bars, with visible focus and narrow-screen overflow contained.",
      "fallback": "An empty month reports honest zero activity, missing provider credentials remain safely diagnosed, and read-only observation never changes quota policy.",
      "navigation": "AI Usage & Quotas opens its existing chart; the canonical People navigation searches one account and returns through existing navigation.",
      "designTarget": "Keep the accepted Admiralty card hierarchy and visual family, adding compact daily metrics, a clearly labeled chart selector, truthful zero bars, UTC labels and distinct settled versus reserved amounts.",
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted public entry establishes hierarchy and a coherent shell around distinct role destinations.",
          "preserve": "Visible account access, clear destinations, cinematic composition and a usable reduced-motion equivalent."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted constrained gateway keeps the same destinations and account access.",
          "preserve": "Mobile task hierarchy, readable controls and contextual navigation."
        }
      ],
      "homeportScreenIds": [
        "screen-page-admin",
        "screen-page-admin-people"
      ],
      "homeportJourneyIds": [
        "B"
      ],
      "browserTests": [
        "tests/e2e/parallax-owner-refinements.spec.ts",
        "tests/e2e/parallax-ai-quotas.spec.ts"
      ],
      "fixtureProfile": "generic",
      "recordingRequired": true,
      "limitations": [
        "Isolated synthetic ledger figures exercise the actual projection and controls; they do not audit a real provider invoice or claim owner product acceptance."
      ],
      "roleSetup": {
        "ADMINISTRATOR": {
          "entryPoint": "/sign-in?returnTo=%2Fadmin%2Fai-usage",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "parallax-review-operator@example.test"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Parallax-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            }
          ],
          "witness": {
            "role": "heading",
            "name": "AI Usage & Quotas",
            "text": "AI Usage & Quotas"
          }
        }
      },
      "journeys": [
        {
          "id": "daily-chart-metrics",
          "roles": [
            "ADMINISTRATOR"
          ],
          "outcome": "An operator compares daily requests with settled and accounted costs, then restores the request chart without policy mutation",
          "steps": [
            {
              "action": "click",
              "role": "combobox",
              "name": "Chart shows"
            },
            {
              "action": "keyboard",
              "key": "Home"
            },
            {
              "action": "keyboard",
              "key": "ArrowDown"
            },
            {
              "action": "keyboard",
              "key": "Enter"
            },
            {
              "action": "assert",
              "role": "figure",
              "name": "Settled cost per day by UTC day",
              "text": "Settled cost per day",
              "path": "/admin/ai-usage",
              "state": "SETTLED_CHART",
              "kind": "outcome",
              "meaning": "Choosing settled cost changes the displayed daily monetary metric while keeping exact canonical request-day accounting available."
            },
            {
              "action": "click",
              "role": "combobox",
              "name": "Chart shows"
            },
            {
              "action": "keyboard",
              "key": "End"
            },
            {
              "action": "keyboard",
              "key": "Enter"
            },
            {
              "action": "assert",
              "role": "figure",
              "name": "Accounted spending per day by UTC day",
              "text": "Accounted spending per day",
              "path": "/admin/ai-usage",
              "state": "ACCOUNTED_CHART",
              "kind": "outcome",
              "meaning": "Choosing accounted spending distinguishes pending reservations and unresolved usage from settled costs."
            },
            {
              "action": "click",
              "role": "combobox",
              "name": "Chart shows"
            },
            {
              "action": "keyboard",
              "key": "Home"
            },
            {
              "action": "keyboard",
              "key": "Enter"
            },
            {
              "action": "assert",
              "role": "figure",
              "name": "Requests per day by UTC day",
              "text": "Requests per day",
              "path": "/admin/ai-usage",
              "state": "RETURNED",
              "returnPath": true
            }
          ]
        },
        {
          "id": "canonical-people-allowance",
          "roles": [
            "ADMINISTRATOR"
          ],
          "outcome": "The ordinary People search opens the existing account allowance controls and returns without adding a separate AI user search",
          "steps": [
            {
              "action": "click",
              "role": "link",
              "name": "People"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Search",
              "value": "parallax-review-creator@example.test"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Search"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Synthetic Parallax Creator"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "text": "AI usage & quotas",
              "path": "/admin/people/00000000-0000-4000-8000-00000000a101",
              "state": "DOSSIER_READY",
              "kind": "outcome",
              "meaning": "The selected canonical account dossier contains its real inherited AI allowance and governed per-user override controls."
            },
            {
              "action": "click",
              "role": "link",
              "name": "People"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "text": "Start with a known clue",
              "path": "/admin/people",
              "state": "PEOPLE_RETURNED",
              "returnPath": true
            }
          ]
        }
      ]
    }
  },
