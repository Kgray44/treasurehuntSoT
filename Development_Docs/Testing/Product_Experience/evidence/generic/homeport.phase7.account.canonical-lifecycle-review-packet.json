        {
          "id": "account-private-read-and-home-return",
          "roles": [
            "CREATOR"
          ],
          "outcome": "The authenticated account owner reads the canonical Personal Information view through its real visible account card, then recovers Home without changing account data.",
          "steps": [
            {
              "action": "assert",
              "role": "heading",
              "name": "Synthetic Parallax Creator",
              "state": "OWNER_IDENTITY_READY"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Profile Personal Information"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "main",
              "name": "",
              "text": "Review account-held identity information and change only what accepted services support.",
              "path": "/account/personal-information",
              "meaning": "The existing private account projection still renders its real task after the expanded shared-content models; it is not replaced by a persisted role or a synthetic success marker.",
              "state": "PERSONAL_INFORMATION_READABLE"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to Home"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "path": "/",
              "returnPath": true,
              "state": "HOME_RETURNED"
            }
          ]
        }
      ],
      "browserTests": [
        "tests/e2e/parallax-shared-consumers.spec.ts"
      ],
      "limitations": [
        "Active-account read, session isolation and natural return compatibility only; unchanged claim, merge, deletion and recovery obligations retain their Homeport authority.",
