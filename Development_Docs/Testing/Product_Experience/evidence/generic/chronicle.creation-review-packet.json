    "critical": true,
    "experience": {
      "persona": "A Creator beginning a Chronicle and shaping its details without mandatory setup",
      "objective": "Choose manual creation, enter the actual editor immediately, and save Chronicle details from that editor",
      "visibleOutcome": "A real owned untitled draft opens directly; its title and complete supported metadata remain editable and saved through the canonical editor",
      "integrationOwner": "Chronicle Creator SC-00A",
      "systems": ["one-voyage"],
