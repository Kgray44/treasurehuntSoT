    "authority": "project-homeport",
    "owners": ["project-homeport", "project-crossdeck", "one-voyage"],
    "critical": true,
    "experience": {
      "persona": "An authorized Player leaving a companion purpose and returning to the same active Voyage",
      "integrationOwner": "Homeport immersive companion shell with Crossdeck continuity",
      "systems": ["project-homeport", "project-crossdeck", "one-voyage"],
      "sourcePaths": [
