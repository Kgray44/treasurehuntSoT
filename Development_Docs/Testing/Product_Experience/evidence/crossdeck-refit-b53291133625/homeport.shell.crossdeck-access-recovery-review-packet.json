{
  "objective": "Read the Player account entry, use canonical sign-in and recovery, and safely return to the phone connection task",
  "contract": {
    "id": "homeport.shell.crossdeck-access-recovery",
    "name": "Homeport readable Player account recovery after companion access ends",
    "authority": "project-homeport",
    "owners": ["project-homeport", "project-crossdeck"],
    "critical": true,
    "experience": {
      "persona": "A signed-out Player returning to the canonical account task after a companion connection loses access",
      "objective": "Read the Player account entry, use canonical sign-in and recovery, and safely return to the phone connection task",
      "visibleOutcome": "Readable Player account instructions and links lead to one canonical account flow and a contextual return to the connection task",
      "integrationOwner": "Project Homeport account experience integration",
      "systems": ["project-homeport"],
      "sourcePaths": [
        "src/app/player/sign-in",
        "src/components/platform/PlayerSignIn.tsx",
        "src/components/platform/PlayerSignIn.module.css"
      ],
      "projectionPaths": ["src/components/wayfarer/AccountFlow.tsx", "src/homeport/return-to.ts"],
      "entryPoint": "/player/sign-in?returnTo=%2Fdevices%2Fpair",
      "states": ["PLAYER_ENTRY_READY", "SIGN_IN_READY", "RECOVERY_READY", "RETURNED"],
      "devices": ["DESKTOP", "MOBILE"],
      "roles": ["ANONYMOUS"],
      "accessibility": "The parchment entry has readable explanation and recovery links; keyboard focus reaches every account and contextual return action without horizontal overflow.",
      "fallback": "The existing canonical account flow remains usable without an identity provider; expired or revoked private companion content is not presented by this anonymous entry.",
      "navigation": "Player account entry opens canonical sign-in; Forgot Password and Return to Sign In retain the safe return intent; Return to previous page restores the phone connection task.",
      "designTarget": "Preserve the current parchment account ledger and its hierarchy, with material-appropriate ink, explicit account actions and a readable safe return.",
      "references": [
        {
          "family": "Authentication",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-003-sign-in-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "The accepted narrow task composition uses one visible objective and a clear recovery/return hierarchy.",
          "preserve": "Readable task-first typography, grouped fields, useful recovery links, intentional narrow-mobile layout."
        },
        {
          "family": "Authentication",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-004-sign-in-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "The accepted mobile account ledger keeps fields and recovery actions readable and reachable.",
          "preserve": "Readable task-first typography, grouped fields, useful recovery links, intentional narrow-mobile layout."
        }
      ],
      "homeportScreenIds": ["screen-page-player-sign-in", "screen-page-sign-in", "screen-page-forgot-password"],
      "homeportJourneyIds": ["C"],
      "browserTests": ["tests/e2e/crossdeck-experience-refit.spec.ts", "tests/e2e/homeport-phase2.spec.ts"],
      "fixtureProfile": "generic",
      "recordingRequired": true,
      "motion": {
        "measurement": "Keyboard activation to the changed visible canonical sign-in, recovery or connection return",
        "feedbackBudgetMs": 5000,
        "justification": "Bound visible account-route feedback in normal and reduced motion within five seconds, without claiming physical-device performance."
      },
      "limitations": [
        "This anonymous recovery composition does not replace authenticated same-person/Voyage pairing, transfer or revocation proof in the Crossdeck contracts.",
        "Live mail delivery, OAuth, physical phone, assistive technology and owner acceptance are not established by this browser journey."
      ],
      "journeys": [
        {
          "id": "player-entry-account-recovery",
          "roles": ["ANONYMOUS"],
          "outcome": "A signed-out Player reaches canonical account recovery through readable controls and returns safely to the phone connection task",
          "steps": [
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "path": "/player/sign-in",
              "text": "Open your Chronicle Library",
              "state": "PLAYER_ENTRY_READY"
            },
            {
              "action": "assert",
              "role": "link",
              "name": "Create Account"
            },
            {
              "action": "assert",
              "role": "link",
              "name": "Forgot Password"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Continue to account sign-in"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "main",
              "name": "",
              "path": "/sign-in",
              "text": "One Voyagewright account",
              "meaning": "The contextual Player entry opens the actual canonical account form",
              "state": "SIGN_IN_READY",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "link",
              "name": "Forgot Password"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "main",
              "name": "",
              "path": "/forgot-password",
              "text": "Send reset instructions",
              "meaning": "Recovery presents the actual email reset task while retaining safe return intent",
              "state": "RECOVERY_READY",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to Sign In"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Sign in",
              "path": "/sign-in"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to previous page"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Bring the adventure with you",
              "path": "/devices/pair",
              "returnPath": true,
              "state": "RETURNED",
              "feedbackBoundary": true
            }
          ]
        }
      ]
    }
  },
