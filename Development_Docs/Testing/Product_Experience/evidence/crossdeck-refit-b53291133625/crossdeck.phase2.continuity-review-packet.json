{
  "objective": "Connect another device from the active Chronicle without losing my place",
  "contract": {
    "id": "crossdeck.phase2.continuity",
    "name": "Crossdeck ordered durable handoff, acknowledgment, custody, continuity and shared-display privacy",
    "authority": "project-crossdeck",
    "owners": ["project-crossdeck", "wayfarer", "player-journal"],
    "critical": true,
    "experience": {
      "persona": "An authorized Player continuing a persisted private synthetic Voyage across personal screens",
      "integrationOwner": "Crossdeck experience refit integration",
      "systems": ["project-crossdeck", "project-parallax", "one-voyage", "project-landfall", "player-journal"],
      "sourcePaths": [
        "src/crossdeck",
        "src/components/crossdeck",
        "src/components/player/journal/ChronicleJournalSession.tsx",
        "src/app/devices",
        "src/app/account/devices",
        "src/components/player/journal",
        "src/app/player/playthroughs/[playthroughId]/journal",
        "src/app/play/[taleSlug]/session/[sessionId]",
        "src/app/player/offline-landfall"
      ],
      "projectionPaths": [
        "src/app/api/crossdeck",
        "src/app/api/play/sessions",
        "src/app/api/player/playthroughs",
        "src/app/api/player/sessions"
      ],
      "devices": ["DESKTOP", "MOBILE"],
      "roles": ["PLAYER"],
      "accessibility": "Every named control is keyboard reachable with visible focus; reduced motion preserves the same task, hierarchy, purpose and safe return.",
      "fallback": "Guided Lens preserves the released clue without camera permission; unavailable device purposes remain explained and disabled while Journal and safe return remain available.",
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted task hierarchy and contextual navigation inform the new device composition; the companion still requires its own independent rendered review.",
          "preserve": "Readable hierarchy, bounded controls, clear destinations and an equivalent constrained/mobile return."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted task hierarchy and contextual navigation inform the new device composition; the companion still requires its own independent rendered review.",
          "preserve": "Readable hierarchy, bounded controls, clear destinations and an equivalent constrained/mobile return."
        }
      ],
      "homeportScreenIds": ["screen-page-player-playthroughs-playthroughid-journal"],
      "browserTests": ["tests/e2e/crossdeck-experience-refit.spec.ts", "tests/e2e/crossdeck-refit-recovery.spec.ts"],
      "fixtureProfile": "generic",
      "recordingRequired": true,
      "continuity": {
        "objective": "Keep the same authorized Voyage and immutable edition through connection, purpose changes and return without inventing progression authority.",
        "checks": [
          {
            "id": "same-voyage",
            "role": "region",
            "name": "Voyage context",
            "attribute": "data-experience-voyage"
          },
          {
            "id": "same-edition",
            "role": "region",
            "name": "Voyage context",
            "attribute": "data-experience-version"
          }
        ]
      },
      "motion": {
        "measurement": "Keyboard activation to the changed visible connection or canonical companion outcome",
        "feedbackBudgetMs": 5000,
        "justification": "Bound the isolated browser transition to useful visible feedback within five seconds, including authorized network projection and supported motion; this is no physical-device performance claim."
      },
      "limitations": [
        "Canonical synthetic account/session setup proves authorization and persisted membership; it does not grant owner acceptance, camera/native spatial capability or real-phone proof.",
        "Actual two-context pairing, handoff acknowledgement, revocation and restricted shared-display privacy remain covered by the dedicated browser specification; the single-context capture signs in and registers through the actual product UI.",
        "The existing generic seed owns only a deterministic synthetic account and persisted edition in a guarded nonce database; real sign-in, authorization and device registration establish each capture surface without injected cookies or tab storage.",
        "The guarded persisted fixture represents an already-opened active Voyage. Every primary entry waits for visible Journal tools, and companion return proves the canonical returning Journal and its replay control rather than assuming a first-open dialog in each signed-in context.",
        "The same synthetic canonical account owns its primary email, one verified secondary email and existing-style Player username. Six-contract captures retain all twenty desktop/mobile and normal/reduced contexts while respecting the unchanged six-per-login sign-in guard; no account/session injection or auth bypass is used."
      ],
      "objective": "Connect another device from the active Chronicle without losing my place",
      "visibleOutcome": "The active Journal opens a contextual private phone connection with QR/code guidance and returns directly to the same Chronicle",
      "entryPoint": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
      "states": ["JOURNAL_READY", "CONNECT_READY", "RETURNED"],
      "navigation": "Open the Journal, use Connect another device, inspect contextual pairing instructions, then Continue the Chronicle in the same Voyage.",
      "designTarget": "Keep the book and its primary reading task dominant; use one quiet contextual connection control, a focused phone dialog with scan-first guidance and a direct return.",
      "roleSetup": {
        "PLAYER": {
          "entryPoint": "/sign-in?returnTo=%2Fplayer%2Fplaythroughs%2F00000000-0000-4000-8000-00000000cd11%2Fjournal",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "crossdeck-review-navigator"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Crossdeck-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            },
            {
              "action": "wait",
              "role": "navigation",
              "name": "Journal tools"
            }
          ],
          "witness": {
            "role": "region",
            "name": "Voyage context",
            "text": "Synthetic Crossdeck refit Voyage"
          }
        }
      },
      "journeys": [
        {
          "id": "contextual-connect-return",
          "roles": ["PLAYER"],
          "outcome": "A Player finds contextual phone connection from the active Journal and returns to the same released reading task",
          "steps": [
            {
              "action": "assert",
              "role": "navigation",
              "name": "Journal tools",
              "text": "chapters",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "state": "JOURNAL_READY"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "text": "Synthetic Crossdeck refit Voyage",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Connect another device"
            },
            {
              "action": "assert",
              "role": "dialog",
              "name": "Bring your phone aboard",
              "kind": "outcome",
              "text": "Sign in with the same Voyagewright account.",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "meaning": "The contextual control produces private phone joining guidance for this Voyage while retaining the active book.",
              "state": "CONNECT_READY",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Continue the Chronicle"
            },
            {
              "action": "assert",
              "role": "navigation",
              "name": "Journal tools",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "absentRole": {
                "role": "dialog",
                "name": "Bring your phone aboard"
              },
              "returnPath": true,
              "state": "RETURNED"
            }
          ]
        }
      ]
    },
    "experienceIntent": {
      "objective": "Use my phone as a Chronicle Lens while continuing the same Voyage on desktop",
      "visibleOutcome": "A contextual pairing flow reaches a role-appropriate Lens with the same identity, Voyage and safe return",
      "integrationOwner": "Crossdeck and Parallax experience integration",
      "systems": ["project-crossdeck", "project-parallax", "one-voyage"],
      "sourcePaths": ["src/crossdeck", "src/components/crossdeck"],
