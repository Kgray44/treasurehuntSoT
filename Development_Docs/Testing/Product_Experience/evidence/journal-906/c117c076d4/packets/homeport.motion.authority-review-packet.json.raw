{
  "objective": "Open the real Showcase from its visible Home link, select reduced motion, and return to the same Home account.",
  "contract": {
    "id": "homeport.motion.authority",
    "name": "Project Homeport Motion Authority",
    "authority": "project-homeport",
    "owners": [
      "project-homeport"
    ],
    "critical": true,
    "experience": {
      "persona": "A synthetic signed-in Creator in the explicitly enabled, task-owned animation harness.",
      "objective": "Open the real Showcase from its visible Home link, select reduced motion, and return to the same Home account.",
      "visibleOutcome": "The guarded owned build opens its actual harness and playback controls, then follows Return to harbor without entering the owner-only spatial pilot.",
      "integrationOwner": "Existing Parallax integration owner #776; Homeport and the animation runtime retain their current identity and playback authority.",
      "accessibility": "Use the visible named harness link, native playback buttons and ordinary Home return on desktop and phone in both motion modes.",
      "fallback": "The accepted task-owned build deliberately enables NEXT_PUBLIC_ENABLE_ANIMATION_LAB. This proves harness availability only; normal-production lab unavailability and physical/provider acceptance are not established here.",
      "navigation": "Home → TEST ANIMATIONS → actual Showcase controls → Return to harbor → Home.",
      "designTarget": "Preserve the existing synthetic development harness composition and truthful harness-only notice.",
      "entryPoint": "/",
      "systems": [
        "project-homeport"
      ],
      "sourcePaths": [
        "src/components/animation/AnimationControls.tsx",
        "src/components/dev/AnimationShowcase.tsx",
        "src/app/dev/animations/page.tsx"
      ],
      "projectionPaths": [
        "src/animation/motion/useMotionMode.ts"
      ],
      "states": [
        "HARNESS_HOME_READY",
        "OWNED_SHOWCASE_READABLE",
        "HARNESS_CONTROLS_READABLE",
        "HARNESS_HOME_RETURNED"
      ],
      "devices": [
        "DESKTOP",
        "MOBILE"
      ],
      "roles": [
        "CREATOR"
      ],
      "fixtureProfile": "generic",
      "roleSetup": {
        "CREATOR": {
          "entryPoint": "/sign-in?returnTo=%2F",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "parallax-review-creator@example.test"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Parallax-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            }
          ],
          "witness": {
            "role": "button",
            "name": "Synthetic Parallax Creator",
            "text": "Synthetic Parallax Creator"
          }
        }
      },
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted shared Homeport gateway frame and return hierarchy; this is not a claim that uncurated Account screenshots were accepted.",
          "preserve": "Readable shared frame, clear account identity and ordinary navigation/return; preserve the unchanged current account task composition."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted shared Homeport gateway frame and return hierarchy; this is not a claim that uncurated Account screenshots were accepted.",
          "preserve": "Readable shared frame, clear account identity and ordinary navigation/return; preserve the unchanged current account task composition."
        }
      ],
      "journeys": [
        {
          "id": "owned-showcase-controls-and-home-return",
          "roles": [
            "CREATOR"
          ],
          "outcome": "The actual explicitly enabled Showcase opens from Home and preserves a visible return after selecting reduced motion; this remains synthetic harness evidence.",
          "steps": [
            {
              "action": "assert",
              "role": "button",
              "name": "Synthetic Parallax Creator",
              "state": "HARNESS_HOME_READY"
            },
            {
              "action": "click",
              "role": "link",
              "name": "TEST ANIMATIONS - open the development animation showcase"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Forever Treasure Animation Showcase",
              "text": "Forever Treasure Animation Showcase",
              "path": "/dev/animations",
              "kind": "outcome",
              "meaning": "The actual Home harness link opens the real explicitly enabled Showcase rather than fabricating a normal-production 404.",
              "state": "OWNED_SHOWCASE_READABLE"
            },
            {
              "action": "click",
              "role": "button",
              "name": "reduced"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Animation playback controls",
              "text": "Motion",
              "path": "/dev/animations",
              "state": "HARNESS_CONTROLS_READABLE"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to harbor"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Synthetic Parallax Creator",
              "path": "/",
              "returnPath": true,
              "state": "HARNESS_HOME_RETURNED"
            }
          ]
        }
      ],
      "browserTests": [
        "tests/e2e/parallax-access-availability.spec.ts"
      ],
      "limitations": [
        "Synthetic guarded harness controls and navigation only. Browser cases assert the selected reduced button aria-pressed state; the capture engine does not support attribute assertions in journey steps.",
        "No normal-production lab availability, progression, camera, physical AR, owner pilot, native or live-provider success is claimed. Shared references cover Home entry/return only; actual harness media still needs independent review."
      ],
      "homeportScreenIds": [],
      "homeportJourneyIds": []
    }
  },
