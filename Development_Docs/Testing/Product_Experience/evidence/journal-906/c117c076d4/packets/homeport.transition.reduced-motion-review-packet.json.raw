    ],
    "critical": true,
    "experience": {
      "persona": "A signed-in Creator editing a local Personal Information draft while system motion changes.",
      "objective": "Keep the animation director, route boundary and existing form feedback compatible without replacing the editor or changing persisted account data.",
      "visibleOutcome": "The real account form exposes its unsaved state, retains value and focus under both OS motion changes, and keeps a usable return to Home.",
      "integrationOwner": "Existing Parallax integration owner #776; Homeport and the animation runtime retain their current account and playback authority.",
      "accessibility": "Preserve keyboard focus, native field labels and the same task in full and reduced motion.",
      "fallback": "Preserve the real unsaved draft, focus and motion-policy boundary. The separate guarded owned Showcase journey covers its explicitly enabled harness; no normal-production lab availability is inferred.",
      "navigation": "Personal Information local draft → visible Unsaved changes feedback → Return to Home.",
      "designTarget": "Preserve current form task hierarchy and accepted shared Homeport frame; judge actual motion and focus from current runtime evidence.",
      "entryPoint": "/account/personal-information",
      "systems": [
        "project-homeport"
      ],
      "sourcePaths": [
        "src/animation/director/AnimationProvider.tsx",
        "src/animation/platform/RouteMotionBoundary.tsx"
      ],
