          "preserve": "Readable shared frame, clear account identity and ordinary navigation/return; preserve the unchanged current account task composition."
        }
      ],
      "journeys": [
        {
          "id": "motion-draft-feedback-and-home-return",
          "roles": [
            "CREATOR"
          ],
          "outcome": "The current form provides visible unsaved feedback and a natural return while the separate browser cases retain local draft identity and focus across OS motion changes.",
          "steps": [
            {
              "action": "assert",
              "role": "heading",
              "name": "Personal Information",
              "state": "MOTION_EDITOR_READY"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Display name",
              "value": "Unsaved motion compatibility draft"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "main",
              "name": "",
              "text": "Unsaved changes",
              "path": "/account/personal-information",
              "meaning": "The actual local form announces its unsaved state; feedback is not presented as saved account data.",
              "state": "DRAFT_FEEDBACK_VISIBLE"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to Home"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "path": "/",
              "returnPath": true,
              "state": "MOTION_HOME_RETURNED"
            }
          ]
        }
      ],
      "browserTests": [
        "tests/e2e/parallax-shared-consumers.spec.ts",
        "tests/e2e/parallax-access-availability.spec.ts"
      ],
      "limitations": [
        "The existing two OS-toggle browser cases prove local draft/focus compatibility; they do not establish physical/native pointing or external provider readiness.",
        "The production-disabled animation lab is covered by actual 404 availability checks, not a claim that its developer playback UI was rendered in production.",
        "Accepted references are shared-frame references only; actual motion/task-body review remains required."
