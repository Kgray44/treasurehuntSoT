              "meaning": "The existing Captain capability opens the live-Voyage workspace without turning a private draft into a published Chronicle.",
              "state": "CAPTAIN_READABLE",
              "text": "Captain's Console"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Published Chronicles"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Synthetic Parallax Workspace Creator"
            },
            {
              "action": "click",
              "role": "link",
              "name": "All Workspaces"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Enter Player"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "heading",
              "name": "My Chronicle Library",
              "path": "/player/library",
              "meaning": "The same session enters its Player library while preserving owner identity and independent capability boundaries.",
              "state": "PLAYER_READABLE",
              "text": "My Chronicle Library"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Synthetic Parallax Workspace Creator"
            },
            {
              "action": "click",
              "role": "link",
              "name": "All Workspaces"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "All Workspaces",
              "path": "/account/roles",
              "returnPath": true,
              "state": "WORKSPACES_RETURNED"
