      "browserTests": [
        "tests/e2e/parallax-workspace-compatibility.spec.ts",
        "tests/e2e/chronicle-studio.spec.ts",
        "tests/e2e/chronicle-platform.spec.ts"
      ],
      "limitations": [
        "Representative cross-workspace compatibility only. Existing extended Chronicle authoring, publishing, Captain control, invitation, Player play, Landfall and active-session safety obligations retain their own test and owner authority.",
        "The four-choice creation entry is deliberately left without choosing manual creation; no Chronicle publication, Crew creation, live session, external inference or physical acceptance is implied.",
        "Legacy wrappers in the source set retain their current canonical route/dependency adapters; their presence is not a claim of a second implementation or a newly accepted legacy UI.",
        "Accepted visual references cover the shared entry/navigation frame only; every newly captured task body still requires independent review.",
        "Browser cases retain these separate domain assertions: The named signed-in actor remains the same canonical account and retains its capability boundary. Private source content remains excluded from another actor and the anonymous public projection. The advertised task return reaches its real parent destination without creating a replacement owner or publishing a private draft."
      ],
      "continuity": {
        "objective": "Observe the same visible synthetic account identity at entry, task outcomes and return. Separate browser cases verify canonical IDs, capabilities and domain privacy; this aria-label alone does not prove them.",
        "checks": [
          {
            "id": "visible-account-identity",
            "role": "button",
            "name": "Synthetic Parallax Workspace Creator",
            "attribute": "aria-label"
          }
        ]
