            {
              "action": "assert",
              "kind": "outcome",
              "role": "heading",
              "name": "Voyagewright Studio",
              "path": "/studio/library",
              "meaning": "A real canonical capability opens the existing owner-scoped Creator library.",
              "state": "CREATOR_READABLE",
              "text": "Voyagewright Studio"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Create Chronicle"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "heading",
              "name": "Create a Chronicle",
              "path": "/studio/tales/new",
              "meaning": "The Chronicle creation entry presents four named intentions without creating or publishing a record.",
              "state": "CREATION_CHOICES_READABLE",
              "text": "Create a Chronicle"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Create Manually Begin with a blank canvas. Shape your Chapters and Passages as inspiration strikes. Begin creating →",
              "state": "CREATION_CHOICES_READABLE"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Create with AI Build alongside the future Chronicle Architect, from a first spark to a story worth sharing. Coming soon",
              "text": "Coming soon",
              "state": "CREATION_CHOICES_READABLE"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Adapt a Story Bring an existing story or document into a new interactive adventure. Coming soon",
              "text": "Coming soon",
              "state": "CREATION_CHOICES_READABLE"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Start from a Template Begin with a ready-made Chronicle structure and make it your own. Coming soon",
              "text": "Coming soon",
              "state": "CREATION_CHOICES_READABLE"
            },
            {
              "action": "click",
              "role": "link",
              "name": "← Your Chronicles"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Voyagewright Studio",
              "path": "/studio/library",
              "state": "CREATOR_RETURNED"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Synthetic Parallax Workspace Creator"
            },
            {
              "action": "click",
              "role": "link",
              "name": "All Workspaces"
            },
            {
              "action": "click",
