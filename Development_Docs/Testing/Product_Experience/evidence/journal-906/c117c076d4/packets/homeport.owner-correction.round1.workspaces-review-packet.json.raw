          "outcome": "One canonical account previews four Chronicle creation intentions, returns across the existing three workspaces without creating a Chronicle, and cannot acquire another owner's private Chronicle.",
          "steps": [
            {
              "action": "assert",
              "role": "heading",
              "name": "All Workspaces",
