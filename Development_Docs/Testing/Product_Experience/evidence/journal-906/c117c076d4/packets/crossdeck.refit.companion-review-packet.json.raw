{
  "objective": "Use my connected screen as a meaningful Lens, Chart, Journal or artifact companion for the same Chronicle",
  "contract": {
    "id": "crossdeck.refit.companion",
    "name": "Crossdeck canonical companion Lens, Chart, Journal, artifact and return experience",
    "authority": "project-crossdeck",
    "owners": [
      "project-crossdeck",
      "project-parallax",
      "landfall",
      "player-journal"
    ],
    "critical": true,
    "experience": {
      "pairedEvidence": {
        "version": 1,
        "caseIds": [
          "crossdeck-pair-normal",
          "crossdeck-pair-reduced",
          "crossdeck-pair-adverse"
        ]
      },
      "persona": "An authorized Player continuing a persisted private synthetic Voyage across personal screens",
      "integrationOwner": "Crossdeck experience refit integration",
      "systems": [
        "project-crossdeck",
        "project-parallax",
        "one-voyage",
        "project-landfall",
        "player-journal"
      ],
      "sourcePaths": [
        "src/components/crossdeck/CrossdeckHandoff.module.css",
        "src/crossdeck",
        "src/components/crossdeck",
        "src/components/player/journal/ChronicleJournalSession.tsx",
        "src/app/devices",
        "src/app/account/devices",
        "src/components/player/journal",
        "src/app/player/playthroughs/[playthroughId]/journal",
        "src/app/play/[taleSlug]/session/[sessionId]",
        "src/app/player/offline-landfall",
        "src/styles/chronicle.css"
      ],
      "projectionPaths": [
        "src/app/api/crossdeck",
        "src/app/api/play/sessions",
        "src/app/api/player/playthroughs",
        "src/app/api/player/sessions"
      ],
      "devices": [
        "DESKTOP",
        "MOBILE"
      ],
      "roles": [
        "PLAYER"
      ],
      "accessibility": "Every named control is keyboard reachable with visible focus; reduced motion preserves the same task, hierarchy, purpose and safe return.",
      "fallback": "Guided Lens preserves the released clue without camera permission; unavailable device purposes remain explained and disabled while Journal and safe return remain available.",
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted task hierarchy and contextual navigation inform the new device composition; the companion still requires its own independent rendered review.",
          "preserve": "Readable hierarchy, bounded controls, clear destinations and an equivalent constrained/mobile return."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted task hierarchy and contextual navigation inform the new device composition; the companion still requires its own independent rendered review.",
          "preserve": "Readable hierarchy, bounded controls, clear destinations and an equivalent constrained/mobile return."
        }
      ],
      "homeportScreenIds": [
        "screen-page-player-playthroughs-playthroughid-journal"
      ],
      "browserTests": [
        "tests/e2e/crossdeck-experience-refit.spec.ts",
        "tests/e2e/crossdeck-refit-recovery.spec.ts"
      ],
      "fixtureProfile": "generic",
      "recordingRequired": true,
      "continuity": {
        "objective": "Keep the same authorized Voyage and immutable edition through connection, purpose changes and return without inventing progression authority.",
        "checks": [
          {
            "id": "same-voyage",
            "role": "region",
            "name": "Voyage context",
            "attribute": "data-experience-voyage"
          },
          {
            "id": "same-edition",
            "role": "region",
            "name": "Voyage context",
            "attribute": "data-experience-version"
          }
        ]
      },
      "motion": {
        "measurement": "Keyboard activation to the changed visible connection or canonical companion outcome",
        "feedbackBudgetMs": 5000,
        "justification": "Bound the isolated browser transition to useful visible feedback within five seconds, including authorized network projection and supported motion; this is no physical-device performance claim."
      },
      "limitations": [
        "Canonical synthetic account/session setup proves authorization and persisted membership; it does not grant owner acceptance, camera/native spatial capability or real-phone proof.",
        "Actual two-context pairing, handoff acknowledgement, revocation and restricted shared-display privacy remain covered by the dedicated browser specification; the single-context capture signs in and registers through the actual product UI.",
        "The existing generic seed owns only a deterministic synthetic account and persisted edition in a guarded nonce database; real sign-in, authorization and device registration establish each capture surface without injected cookies or tab storage.",
        "The guarded persisted fixture represents an already-opened active Voyage. Every primary entry waits for visible Journal tools, and companion return proves the canonical returning Journal and its replay control rather than assuming a first-open dialog in each signed-in context.",
        "The same synthetic canonical account owns its primary email, one verified secondary email and existing-style Player username. Six-contract captures retain all twenty desktop/mobile and normal/reduced contexts while respecting the unchanged six-per-login sign-in guard; no account/session injection or auth bypass is used."
      ],
      "objective": "Use my connected screen as a meaningful Lens, Chart, Journal or artifact companion for the same Chronicle",
      "visibleOutcome": "Changing companion purpose opens the canonical released clue, actual Voyage chart, readable full passage or released artifact and returns to the same immutable Chronicle",
      "entryPoint": "/devices/companion?voyage=00000000-0000-4000-8000-00000000cd11",
      "states": [
        "JOURNAL_READY",
        "LENS_READY",
        "CHART_READY",
        "ARTIFACT_READY",
        "JOURNAL_RESTORED",
        "RETURNED"
      ],
      "navigation": "Begin on the authorized paired companion; Change companion purpose reaches Lens, Chart, Journal and Artifact viewer; Return to Chronicle opens the original Journal.",
      "designTarget": "Give each purpose its full readable workspace beneath one Chronicle identity and connection status, with discoverable, operable purpose selection and persistent unobscured return, camera-free meaningful Lens and actual map objectives. Editorial ranking and grouping of purpose/connection utilities and appearance refinement are assigned to Project Refit after all functional reading, purpose and return criteria pass.",
      "roleSetup": {
        "PLAYER": {
          "entryPoint": "/sign-in?returnTo=%2Faccount%2Fdevices%3Fvoyage%3D00000000-0000-4000-8000-00000000cd11",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "crossdeck-review+companion@example.test"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Crossdeck-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Device name",
              "value": "Phone"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Use this device"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Open on this device"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Journal companion"
            }
          ],
          "witness": {
            "role": "region",
            "name": "Journal companion",
            "text": "The harbour falls quiet behind you."
          }
        }
      },
      "journeys": [
        {
          "id": "companion-purpose-return",
          "roles": [
            "PLAYER"
          ],
          "outcome": "A Player experiences released Lens content, the actual current Chart and complete Journal/artifact content before safely returning to the same Chronicle",
          "steps": [
            {
              "action": "assert",
              "role": "region",
              "name": "Journal companion",
              "text": "The harbour falls quiet behind you.",
              "state": "JOURNAL_READY"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Chronicle Lens"
            },
            {
              "action": "assert",
              "role": "dialog",
              "name": "A message between worlds",
              "kind": "outcome",
              "text": "The next bearing is written in the stars. Look for the northern light.",
              "path": "/devices/companion",
              "meaning": "Purpose selection opens the canonical guided spatial moment and its released clue, rather than retaining a role label.",
              "state": "LENS_READY",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Close Chronicle Lens"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Voyage Chart"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Chart companion",
              "kind": "outcome",
              "text": "Current objective: Secret Isle",
              "path": "/devices/companion",
              "meaning": "The Chart purpose renders the canonical released virtual map and its current authored objective for this Voyage.",
              "state": "CHART_READY",
              "feedbackBoundary": true
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Voyage Chart"
            },
            {
              "action": "assert",
              "role": "img",
              "name": "Virtual Landfall chart"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "More purposes"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Artifact viewer"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Artifact viewer",
              "kind": "outcome",
              "text": "A small compass worn smooth by a hundred voyages.",
              "path": "/devices/companion",
              "meaning": "The artifact purpose renders the actual released keepsake and its readable description for the same immutable edition.",
              "state": "ARTIFACT_READY",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Change companion purpose"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Journal companion"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Journal companion",
              "kind": "outcome",
              "text": "The harbour falls quiet behind you.",
              "path": "/devices/companion",
              "meaning": "Returning to Journal restores full readable released passage content while the primary screen keeps its reading state.",
              "state": "JOURNAL_RESTORED",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Use larger reading size"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to Chronicle"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Replay full opening"
            },
            {
              "action": "assert",
              "role": "navigation",
              "name": "Journal tools",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "returnPath": true,
              "state": "RETURNED"
            }
          ]
        }
      ],
      "homeportJourneyIds": []
    }
  },
