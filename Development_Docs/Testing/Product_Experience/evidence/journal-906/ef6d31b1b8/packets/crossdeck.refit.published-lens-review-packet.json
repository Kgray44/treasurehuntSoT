            }
          ],
          "witness": {
            "role": "region",
            "name": "Voyage context",
            "text": "Synthetic Crossdeck refit Voyage"
          }
        }
      },
      "journeys": [
        {
          "id": "published-clue-inspect-return",
          "roles": ["PLAYER"],
          "outcome": "The published spatial attachment reaches canonical Guided Lens, offers actual Inspect interaction and returns to the same authorized edition",
          "steps": [
            {
              "action": "assert",
              "role": "navigation",
              "name": "Journal tools",
              "text": "chapters",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "state": "JOURNAL_READY"
            },
            {
              "action": "assert",
              "role": "main",
              "name": "",
              "text": "Synthetic Crossdeck refit Voyage",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal"
            },
            {
              "action": "click",
