{
  "objective": "Public Community projection and private-profile compatibility",
  "contract": {
    "id": "homeport.community.public-projection",
    "name": "Community Harbor public Projection",
    "authority": "project-homeport",
    "owners": [
      "project-homeport",
      "harborlight"
    ],
    "critical": true,
    "experience": {
      "persona": "A signed-in Creator using existing Community Harbor features.",
      "objective": "Public Community projection and private-profile compatibility",
      "visibleOutcome": "Public Community projection and private-profile compatibility",
      "integrationOwner": "Existing Parallax integration owner #776; Harborlight retains Community projection, consent, moderation and publication authority.",
      "accessibility": "Preserve named headings, visible returns, desktop keyboard operation and phone access in both motion modes.",
      "fallback": "Preserve real empty, denied and unavailable states. Private identities and draft content never fill public shelves.",
      "navigation": "Use the visible Community task and its parent return.",
      "designTarget": "Preserve current Community composition and accepted shared Homeport entry hierarchy.",
      "entryPoint": "/community/creators",
      "systems": [
        "project-homeport",
        "harborlight"
      ],
      "sourcePaths": [
        "src/app/community/artifacts/page.tsx",
        "src/app/community/audio/page.tsx",
        "src/app/community/chronicles/page.tsx",
        "src/app/community/collections/[slug]/page.tsx",
        "src/app/community/collections/page.tsx",
        "src/app/community/creators/[handle]/page.tsx",
        "src/app/community/creators/page.tsx",
        "src/app/community/featured/page.tsx",
        "src/app/community/guides/[slug]/page.tsx",
        "src/app/community/guides/page.tsx",
        "src/app/community/maps/page.tsx",
        "src/app/community/page.tsx",
        "src/app/community/templates/page.tsx",
        "src/app/community/voyage-logs/page.tsx",
        "src/components/community/CommunityCardGrid.tsx",
        "src/components/community/CommunityCommentThread.tsx",
        "src/components/community/CommunityDiscoveryBrowser.tsx",
        "src/components/community/CommunitySceneCeremony.tsx",
        "src/components/community/PublicCommunitySection.tsx"
      ],
      "projectionPaths": [
        "src/community/homeport.ts",
        "src/community/public-profile.ts",
        "src/community/voyage-log-owner.ts"
      ],
      "states": [
        "CREATOR_DISTRICT_READY",
        "PUBLIC_CREATOR_READABLE",
        "CREATOR_DISTRICT_RETURNED"
      ],
      "devices": [
        "DESKTOP",
        "MOBILE"
      ],
      "roles": [
        "CREATOR"
      ],
      "fixtureProfile": "generic",
      "roleSetup": {
        "CREATOR": {
          "entryPoint": "/sign-in?returnTo=%2Fcommunity%2Fcreators",
          "steps": [
            {
              "action": "fill",
              "role": "textbox",
              "name": "Email or Player name",
              "value": "parallax-review-creator@example.test"
            },
            {
              "action": "fill",
              "role": "textbox",
              "name": "Password",
              "value": "Synthetic-Parallax-Review-2026!"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Sign in"
            }
          ],
          "witness": {
            "role": "main",
            "name": "",
            "text": "Public Community profiles and their eligible published work, without private account or provider data."
          }
        }
      },
      "references": [
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted shared Homeport entry and return framing only; no accepted Community-body visual baseline is asserted.",
          "preserve": "Readable shared hierarchy and account continuity; review the actual current Community task body independently."
        },
        {
          "family": "Gateway / public entry",
          "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
          "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
          "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
          "reason": "Accepted shared Homeport entry and return framing only; no accepted Community-body visual baseline is asserted.",
          "preserve": "Readable shared hierarchy and account continuity; review the actual current Community task body independently."
        }
      ],
      "journeys": [
        {
          "id": "community-public-creator-and-parent-return",
          "roles": [
            "CREATOR"
          ],
          "outcome": "The existing public projection opens a Community-visible Creator without private account data, then returns to the originating Creator district.",
          "steps": [
            {
              "action": "assert",
              "role": "heading",
              "name": "Creators",
              "state": "CREATOR_DISTRICT_READY"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Synthetic Parallax Public Compatibility Creator"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "heading",
              "name": "Synthetic Parallax Public Compatibility Creator",
              "meaning": "A real public compatibility projection resolves through the ordinary Creator card; private Player Profile data remains excluded.",
              "state": "PUBLIC_CREATOR_READABLE",
              "text": "Synthetic Parallax Public Compatibility Creator",
              "path": "/community/creators/synthetic-parallax-public-compatibility-creator"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Browse other Creators"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Creators",
              "path": "/community/creators",
              "returnPath": true,
              "state": "CREATOR_DISTRICT_RETURNED"
            }
          ]
        }
      ],
      "browserTests": [
        "tests/e2e/parallax-community-compatibility.spec.ts",
        "tests/e2e/harborlight-phase3.spec.ts"
      ],
      "limitations": [
        "Representative public Creator/district read journey; existing full discovery, comments, eligibility, consent and publication suites retain their obligations.",
        "Accepted references cover shared framing only. Actual Community-body capture and independent review remain required.",
        "Browser cases retain these separate domain assertions: The named signed-in actor remains the same canonical account and retains its capability boundary. Private source content remains excluded from another actor and the anonymous public projection. The advertised task return reaches its real parent destination without creating a replacement owner or publishing a private draft."
      ],
      "continuity": {
        "objective": "Observe the same visible synthetic account identity at entry, task outcomes and return. Separate browser cases verify canonical IDs, capabilities and domain privacy; this aria-label alone does not prove them.",
        "checks": [
          {
            "id": "visible-account-identity",
            "role": "button",
            "name": "Synthetic Parallax Creator",
            "attribute": "aria-label"
          }
        ]
      },
      "homeportScreenIds": [],
      "homeportJourneyIds": []
    }
  },
