{
  "objective": "Open the real Showcase from its visible Home link, select reduced motion, and return to the same Home account.",
  "contract": {
    "id": "homeport.motion.authority",
    "name": "Project Homeport Motion Authority",
    "authority": "project-homeport",
    "owners": [
      "project-homeport"
    ],
    "critical": true,
    "experience": {
      "persona": "A synthetic signed-in Creator in the explicitly enabled, task-owned animation harness.",
      "objective": "Open the real Showcase from its visible Home link, select reduced motion, and return to the same Home account.",
      "visibleOutcome": "The guarded owned build opens its actual harness and playback controls, then follows Return to harbor without entering the owner-only spatial pilot.",
      "integrationOwner": "Existing Parallax integration owner #776; Homeport and the animation runtime retain their current identity and playback authority.",
      "accessibility": "Use the visible named harness link, native playback buttons and ordinary Home return on desktop and phone in both motion modes.",
      "fallback": "The accepted task-owned build deliberately enables NEXT_PUBLIC_ENABLE_ANIMATION_LAB. This proves harness availability only; normal-production lab unavailability and physical/provider acceptance are not established here.",
      "navigation": "Home → TEST ANIMATIONS → actual Showcase controls → Return to harbor → Home.",
      "designTarget": "Preserve the existing synthetic development harness composition and truthful harness-only notice.",
      "entryPoint": "/",
      "systems": [
        "project-homeport"
      ],
      "sourcePaths": [
        "src/components/animation/AnimationControls.tsx",
        "src/components/dev/AnimationShowcase.tsx",
        "src/app/dev/animations/page.tsx"
      ],
      "projectionPaths": [
        "src/animation/motion/useMotionMode.ts"
      ],
      "states": [
        "HARNESS_HOME_READY",
        "OWNED_SHOWCASE_READABLE",
        "HARNESS_CONTROLS_READABLE",
        "HARNESS_HOME_RETURNED"
      ],
      "devices": [
        "DESKTOP",
        "MOBILE"
      ],
      "roles": [
        "CREATOR"
      ],
      "fixtureProfile": "generic",
      "roleSetup": {
