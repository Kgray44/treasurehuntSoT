          "preserve": "Readable shared frame, clear account identity and ordinary navigation/return; preserve the unchanged current account task composition."
        }
      ],
      "journeys": [
        {
          "id": "owned-showcase-controls-and-home-return",
          "roles": [
            "CREATOR"
          ],
          "outcome": "The actual explicitly enabled Showcase opens from Home and preserves a visible return after selecting reduced motion; this remains synthetic harness evidence.",
          "steps": [
            {
              "action": "assert",
              "role": "button",
              "name": "Synthetic Parallax Creator",
              "state": "HARNESS_HOME_READY"
            },
            {
              "action": "click",
              "role": "link",
              "name": "TEST ANIMATIONS - open the development animation showcase"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Forever Treasure Animation Showcase",
              "text": "Forever Treasure Animation Showcase",
              "path": "/dev/animations",
              "kind": "outcome",
              "meaning": "The actual Home harness link opens the real explicitly enabled Showcase rather than fabricating a normal-production 404.",
              "state": "OWNED_SHOWCASE_READABLE"
            },
            {
              "action": "click",
              "role": "button",
              "name": "reduced"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Animation playback controls",
              "text": "Motion",
              "path": "/dev/animations",
              "state": "HARNESS_CONTROLS_READABLE"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Return to harbor"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Synthetic Parallax Creator",
              "path": "/",
              "returnPath": true,
              "state": "HARNESS_HOME_RETURNED"
            }
          ]
        }
      ],
      "browserTests": [
        "tests/e2e/parallax-access-availability.spec.ts"
      ],
      "limitations": [
        "Synthetic guarded harness controls and navigation only. Browser cases assert the selected reduced button aria-pressed state; the capture engine does not support attribute assertions in journey steps.",
        "No normal-production lab availability, progression, camera, physical AR, owner pilot, native or live-provider success is claimed. Shared references cover Home entry/return only; actual harness media still needs independent review."
      ],
      "homeportScreenIds": [],
      "homeportJourneyIds": []
    }
  },
