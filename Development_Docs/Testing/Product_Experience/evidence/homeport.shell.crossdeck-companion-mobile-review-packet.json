              "name": "Exit to My Voyages"
            },
            {
              "action": "assert",
              "kind": "outcome",
              "role": "main",
              "name": "",
              "text": "Synthetic Crossdeck refit Voyage",
              "path": "/player/library",
              "meaning": "The companion context exit opens the authorized Chronicle Library with the same current adventure, rather than leaving a trapped or generic account task.",
              "state": "LIBRARY_READY",
              "feedbackBoundary": true
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "My Chronicle Library"
            },
            {
              "action": "click",
              "role": "link",
              "name": "Continue Adventure"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Replay full opening"
            },
            {
              "action": "assert",
              "role": "navigation",
              "name": "Journal tools",
              "path": "/player/playthroughs/00000000-0000-4000-8000-00000000cd11/journal",
              "returnPath": true,
              "state": "RETURNED"
            },
            {
              "action": "assert",
              "role": "button",
              "name": "Continue Voyage",
              "unobscured": true
