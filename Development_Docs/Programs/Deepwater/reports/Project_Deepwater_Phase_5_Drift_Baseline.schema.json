{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "phase",
    "sourceSha",
    "capabilityCount",
    "featureCatalogCount",
    "capabilities",
    "inventories",
    "backendSurfaces"
  ],
  "properties": {
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capabilityCount": { "type": "integer", "minimum": 0 },
    "featureCatalogCount": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capabilityId", "owner", "disposition", "terminalRung", "classification", "evidence"]
      }
    },
    "inventories": { "type": "object", "required": ["routeIds", "screenIds", "journeyIds", "catalogIds"] },
    "backendSurfaces": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "path"] } }
  }
}
