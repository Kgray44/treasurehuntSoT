{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "comparison", "deltas"],
  "properties": {
    "comparison": { "type": "object", "required": ["priorSourceSha", "currentSourceSha"] },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "capabilityId",
          "sourceIdentities",
          "reason",
          "humanReviewRequired",
          "soundingLineEvidenceInvalidated",
          "owner"
        ]
      }
    }
  }
}
