+// Voyagewright evaluation: use the same uncropped camera projection in tracking,
+// unprojection and rendering. This is not lens correction or metric calibration.
+EMSCRIPTEN_KEEPALIVE
+int setCameraIntrinsics(int width, int height, double fx, double fy, double cx, double cy) {
+    if (width < 10 || height < 10 || !std::isfinite(fx) || !std::isfinite(fy) ||
+        !std::isfinite(cx) || !std::isfinite(cy) || fx <= 1.0 || fy <= 1.0 ||
+        cx < 0.0 || cy < 0.0 || cx > width || cy > height) return 0;
+    g_state.resetTrackingSession();
+    g_state.cameraWidth = width; g_state.cameraHeight = height;
+    g_state.cameraFx = fx; g_state.cameraFy = fy; g_state.cameraCx = cx; g_state.cameraCy = cy;
+    return g_state.updateIntrinsics(width, height) ? 1 : 0;
+}
