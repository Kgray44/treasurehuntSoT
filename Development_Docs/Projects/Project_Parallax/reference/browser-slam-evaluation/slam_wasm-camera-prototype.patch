+// Remove the flow predicted by the known camera rotation before admitting a
+// translational baseline. Turning in place alone cannot initialize a 3D map.
+std::vector<Point2f> rotatedPixels(const std::vector<Point2f>& points,
+                                 const Mat& rotation, const EngineState& state) {
+    const Mat homography = state.camMatrix * rotation * state.camMatrixInv;
+    std::vector<Point2f> result;
+    perspectiveTransform(points, result, homography);
+    return result;
+}
