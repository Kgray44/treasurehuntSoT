              "role": "heading",
              "name": "Selection unavailable",
              "text": "Selection unavailable",
              "path": "/studio/parallax",
              "state": "INVALID_SELECTION",
              "kind": "outcome",
              "meaning": "A removed object is identified as unavailable instead of silently showing unrelated scene controls.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Undo"
            },
            {
              "action": "assert",
              "role": "complementary",
              "name": "Spatial inspector",
              "text": "Place and shape this object visually",
              "path": "/studio/parallax",
              "state": "RESTORED_SELECTION",
              "kind": "outcome",
              "meaning": "Undo restores the selected object's editable Inspector without changing selection identity.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "link",
              "name": "← Creator Studio"
            },
