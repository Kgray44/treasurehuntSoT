              "path": "/studio/parallax",
              "state": "CONTEXT",
              "kind": "outcome",
              "meaning": "Placement and relationships are reachable without changing the selected object.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Open scene settings"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Scene settings",
              "text": "Scene settings",
              "path": "/studio/parallax",
              "state": "SCENE",
              "kind": "outcome",
              "meaning": "Scene fallback, library metadata and versions have a real destination.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Desk Map"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Clear selection"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Scene overview",
              "text": "In this scene",
              "path": "/studio/parallax",
              "state": "EMPTY_SELECTION",
              "kind": "outcome",
              "meaning": "Clearing selection intentionally exposes the scene and preserves the authored objects.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Desk Map"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Duplicate"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Delete"
            },
            {
