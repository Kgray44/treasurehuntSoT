            },
            {
              "action": "click",
              "role": "button",
              "name": "Open spatial context"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Spatial context",
              "text": "Spatial context",
              "path": "/studio/parallax",
              "state": "CONTEXT",
              "kind": "outcome",
              "meaning": "Placement and relationships are reachable without changing the selected object.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Open scene settings"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Scene settings",
              "text": "Scene settings",
              "path": "/studio/parallax",
              "state": "SCENE",
              "kind": "outcome",
              "meaning": "Scene fallback, library metadata and versions have a real destination.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Desk Map"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Clear selection"
            },
            {
              "action": "assert",
              "role": "region",
              "name": "Scene overview",
              "text": "In this scene",
              "path": "/studio/parallax",
              "state": "EMPTY_SELECTION",
              "kind": "outcome",
              "meaning": "Clearing selection intentionally exposes the scene and preserves the authored objects.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Desk Map"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Duplicate"
            },
            {
              "action": "click",
              "role": "button",
              "name": "Delete"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Selection unavailable",
              "text": "Selection unavailable",
              "path": "/studio/parallax",
              "state": "INVALID_SELECTION",
              "kind": "outcome",
              "meaning": "A removed object is identified as unavailable instead of silently showing unrelated scene controls.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "button",
              "name": "Undo"
            },
            {
              "action": "assert",
              "role": "complementary",
              "name": "Spatial inspector",
              "text": "Place and shape this object visually",
              "path": "/studio/parallax",
              "state": "RESTORED_SELECTION",
              "kind": "outcome",
              "meaning": "Undo restores the selected object's editable Inspector without changing selection identity.",
              "feedbackBoundary": true
            },
            {
              "action": "click",
              "role": "link",
              "name": "← Creator Studio"
            },
            {
              "action": "assert",
              "role": "heading",
              "name": "Voyagewright Studio",
              "text": "Voyagewright Studio",
              "path": "/studio/library",
              "state": "RETURNED",
              "returnPath": true
