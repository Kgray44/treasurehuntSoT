      "owner": "tideglass",
      "shellMode": "WORKSPACE_STANDARD",
      "logicalParent": "/studio/tales/[taleId]/versions",
      "visibleEntries": [
        {
          "source": "src/components/studio/TaleEditor.tsx",
          "label": "Compare to current"
        }
      ],
      "returnBehavior": "The panel closes locally without changing published edition, draft, session, or annotation truth.",
      "states": ["SEMANTIC_PROJECTION", "NO_MEANINGFUL_CHANGE", "PARTIAL", "COMPATIBILITY", "ANNOTATIONS", "ERROR"],
      "accessContract": "Creator workspace and Chronicle ownership are rechecked before an exact Tideglass comparison and CREATOR_FULL projection. No legacy path/value diff is returned."
    }
  ]
