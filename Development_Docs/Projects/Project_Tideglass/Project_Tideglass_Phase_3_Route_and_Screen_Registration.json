          "source": "src/components/homeport/PassportSurfaces.tsx",
          "label": "See what changed",
          "ownerBoundRedirect": "/passport/history/[recordId]/compare"
        }
      ],
      "returnBehavior": "Allowlisted same-origin Chronicle, Passport, Tales, or Studio return path; invalid values fall back to the Chronicle detail.",
      "states": [
        "LOADING",
        "UNAVAILABLE_WITH_RETRY",
        "SELECTION_REQUIRED",
        "PAIR",
        "UP_TO_DATE",
        "NO_MEANINGFUL_CHANGE",
        "PARTIAL",
        "CONCISE",
        "DETAILED",
        "DISCLOSURE_COLLAPSED",
        "DISCLOSURE_REVEALED",
        "CATEGORY_FILTERED"
      ],
      "accessContract": "GET and POST derive edition visibility, history ownership, exact pair authorization, and audience on the server. Query state cannot elevate an audience or authorize a foreign record."
    },
    {
      "routeId": "tideglass-passport-history-compare-redirect",
      "pattern": "/passport/history/[recordId]/compare",
      "source": "src/app/passport/history/[recordId]/compare/page.tsx",
      "screen": "Owner-bound compare handoff",
      "owner": "wayfarer-with-tideglass-passage",
      "shellMode": "WORKSPACE_STANDARD",
      "logicalParent": "/passport/history/[recordId]",
      "visibleEntries": [
        {
          "source": "src/components/homeport/PassportSurfaces.tsx",
          "label": "See what changed"
        }
      ],
      "returnBehavior": "Redirects only after the signed-in owner record resolves its trusted Chronicle slug; non-owner or missing records return not-found.",
      "states": ["OWNER_REDIRECT", "NOT_FOUND"],
      "accessContract": "The redirect does not add the edition or slug to the Passport API DTO and does not trust client-supplied tale identity."
    },
    {
      "routeId": "tideglass-studio-semantic-comparison",
      "pattern": "/api/studio/tales/[taleId]/versions/compare",
