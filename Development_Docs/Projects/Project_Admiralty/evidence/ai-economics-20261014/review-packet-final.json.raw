      {
        "id": "admiralty.phase1.registry",
        "name": "Living capability-floor registry",
        "authority": "project-admiralty",
        "owners": [
          "project-admiralty"
        ],
        "critical": true,
        "experience": {
          "persona": "An authorized Admiralty operator observing daily AI spending and existing account allowances",
          "objective": "Compare daily requests and costs, then inspect a user allowance through the normal People search",
          "visibleOutcome": "A selectable daily chart distinguishes requests, settled cost and accounted exposure; per-user controls remain in the existing People dossier",
          "integrationOwner": "Admiralty AI usage experience integration",
          "systems": [
            "project-admiralty"
          ],
          "sourcePaths": [
            "src/components/admiralty/AIQuotaConsole.tsx",
            "src/components/admiralty/AIQuotaConsole.module.css",
            "src/components/admiralty/AIQuotaUserPanel.tsx",
            "src/app/admin/ai-usage",
            "src/app/admin/people"
          ],
          "projectionPaths": [
            "src/parallax/ai-quota-projections.ts"
          ],
          "entryPoint": "/admin/ai-usage",
          "states": [
            "SETTLED_CHART",
            "ACCOUNTED_CHART",
            "RETURNED",
            "DOSSIER_READY",
            "PEOPLE_RETURNED"
          ],
          "devices": [
            "DESKTOP",
            "MOBILE"
          ],
          "roles": [
            "ADMINISTRATOR"
          ],
          "accessibility": "A labeled keyboard-operable metric selector and exact daily table preserve access beyond visual bars, with visible focus and narrow-screen overflow contained.",
          "fallback": "An empty month reports honest zero activity, missing provider credentials remain safely diagnosed, and read-only observation never changes quota policy.",
          "navigation": "AI Usage & Quotas opens its existing chart; the canonical People navigation searches one account and returns through existing navigation.",
          "designTarget": "Keep the accepted Admiralty card hierarchy and visual family, adding compact daily metrics, a clearly labeled chart selector, truthful zero bars, UTC labels and distinct settled versus reserved amounts.",
          "references": [
            {
              "family": "Gateway / public entry",
              "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-001-root-standard-desktop.png",
              "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
              "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
              "reason": "Accepted public entry establishes hierarchy and a coherent shell around distinct role destinations.",
              "preserve": "Visible account access, clear destinations, cinematic composition and a usable reduced-motion equivalent."
            },
            {
              "family": "Gateway / public entry",
              "path": "Development_Docs/Projects/Project_Homeport/evidence/phase6/HP-P6-EV-002-root-modern-mobile.png",
              "sourceSha": "e02ee0dae0469a2ba573beaf409c0b34e8668d09",
              "maturity": "ACCEPTED_HOMEPORT_VISUAL_REFERENCE",
              "reason": "Accepted constrained gateway keeps the same destinations and account access.",
              "preserve": "Mobile task hierarchy, readable controls and contextual navigation."
            }
          ],
          "homeportScreenIds": [
