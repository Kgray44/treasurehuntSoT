# Copy to .env.local for local development. Values below are non-production placeholders.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
GM_USERNAME="kato"
GM_PASSWORD="replace-with-a-local-development-password"
PLAYER_ACCESS_CODE="replace-with-a-private-development-code"
PLAYER_USERNAME="sera"
PLAYER_PASSWORD="replace-with-a-local-player-password"
# Server-only public browser origin used in transactional links and OAuth application redirects.
HOMEPORT_PUBLIC_APP_ORIGIN="http://localhost:3000"
# Comma-separated exact development hostnames only. No schemes, ports, paths, or wildcards.
# scripts/start-dev.ps1 -Lan adds the machine's current LAN address for that process.
HOMEPORT_ALLOWED_DEV_ORIGINS=""
# Server-only same-host Bridgewatch gateway target. Only loopback HTTP with no
# credentials, path, query, or fragment is accepted; browser input cannot override it.
BRIDGEWATCH_INTERNAL_URL="http://127.0.0.1:4318"
LOG_LEVEL="info"
PROJECT_ONE_VOYAGE_STAGE="F_COMPATIBILITY_ONLY"

# Server-only Voyagewright OAuth application configuration. Keep real values in
# an ignored .env.local or the deployment secret store. Never use NEXT_PUBLIC_.
# Staging callbacks:
# https://staging.absoluterelativesystems.com/api/auth/providers/google/callback
# https://staging.absoluterelativesystems.com/api/auth/providers/github/callback
VOYAGEWRIGHT_GOOGLE_CLIENT_ID=""
VOYAGEWRIGHT_GOOGLE_CLIENT_SECRET=""
VOYAGEWRIGHT_GOOGLE_REDIRECT_URI=""
VOYAGEWRIGHT_GITHUB_CLIENT_ID=""
VOYAGEWRIGHT_GITHUB_CLIENT_SECRET=""
VOYAGEWRIGHT_GITHUB_REDIRECT_URI=""
# Optional local GitHub automation control-plane state. This is server-side
# only and must not contain a token. App private-key material stays outside
# this repository; installation tokens are short-lived and memory-only.
# VOYAGEWRIGHT_GITHUB_STATE_DIR=""
# VOYAGEWRIGHT_GITHUB_APP_ID=""
# VOYAGEWRIGHT_GITHUB_APP_INSTALLATION_ID=""
# VOYAGEWRIGHT_GITHUB_APP_PRIVATE_KEY_PATH="C:\\Secure\\voyagewright-automation.pem"
# Deterministic local validation only; the application refuses it in production.
VOYAGEWRIGHT_OAUTH_TEST_MODE="0"

# Transactional email is server-only. Local tests use SYNTHETIC_OUTBOX. Resend
# is the selected real provider; set these only in an ignored server environment
# such as .env.local after the sending domain is verified. Webhooks are deferred.
HOMEPORT_TRANSACTIONAL_EMAIL_PROVIDER="SYNTHETIC_OUTBOX"
# RESEND_API_KEY=""
# RESEND_FROM_ADDRESS=""
# RESEND_FROM_NAME="Voyagewright"
# Harness-only owner-controlled inbox; never required by the application.
# RESEND_LIVE_TEST_RECIPIENT=""

# Dormant Postmark compatibility adapter. It is not the selected real provider.
# POSTMARK_SERVER_TOKEN=""
# POSTMARK_FROM_ADDRESS=""
# POSTMARK_FROM_NAME="Voyagewright"
# POSTMARK_TRANSACTIONAL_MESSAGE_STREAM="outbound"
# POSTMARK_TEMPLATE_ALIAS_VERIFY_EMAIL=""
# POSTMARK_TEMPLATE_ALIAS_PASSWORD_RESET=""
# POSTMARK_TEMPLATE_ALIAS_EMAIL_CHANGE=""
# POSTMARK_TEMPLATE_ALIAS_SECURITY_NOTICE=""
# POSTMARK_TEMPLATE_ALIAS_ACCOUNT_LIFECYCLE=""
# POSTMARK_WEBHOOK_USERNAME=""
# POSTMARK_WEBHOOK_PASSWORD=""

# Optional absolute path for a durable asset volume. Omit to use .data/chronicle-assets.
# CHRONICLE_ASSET_ROOT="D:\ForeverTreasureAssets"
CHRONICLE_MAX_UPLOAD_MB="25"
# Absolute paths outside this repository, public/, .next/, and source directories.
# Private package keys/passphrases are never environment defaults or browser-visible values.
PRIVATE_CONTENT_ROOT="D:\\ForeverTreasurePrivateContent"
PRIVATE_CONTENT_STAGING_ROOT="D:\\ForeverTreasurePrivateStaging"
PRIVATE_CONTENT_MAX_PACKAGE_BYTES="33554432"
PRIVATE_CONTENT_MAX_PLAINTEXT_BYTES="50331648"
PRIVATE_CONTENT_MAX_ASSET_BYTES="25165824"
PRIVATE_CONTENT_MAX_FILE_COUNT="256"
PRIVATE_CONTENT_IMPORT_ENABLED="true"
# Phase 3 operational configuration. All values are server-side; never use a NEXT_PUBLIC_ prefix.
PRIVATE_CONTENT_ENVIRONMENT_ID="local-development"
PRIVATE_CONTENT_ENABLED="true"
PRIVATE_CONTENT_STORAGE_PROVIDER="local"
PRIVATE_CONTENT_PROVIDER_ROOT="D:\\ForeverTreasurePrivateProvider"
# PRIVATE_CONTENT_S3_ENDPOINT="https://minio.example.invalid"
# PRIVATE_CONTENT_S3_REGION="us-east-1"
# PRIVATE_CONTENT_S3_BUCKET="forever-treasure-private"
PRIVATE_CONTENT_S3_PREFIX="sealed-hold"
PRIVATE_CONTENT_S3_FORCE_PATH_STYLE="true"
PRIVATE_CONTENT_S3_TLS_REQUIRED="true"
PRIVATE_CONTENT_SCANNER_PROVIDER="disabled"
# PRIVATE_CONTENT_CLAMAV_HOST="127.0.0.1"
PRIVATE_CONTENT_CLAMAV_PORT="3310"
PRIVATE_CONTENT_CLAMAV_TIMEOUT_MS="5000"
PRIVATE_CONTENT_CLAMAV_REQUIRED="true"
PRIVATE_CONTENT_KEY_PROVIDER="local"
# Set only in protected local/server environment files; no default or placeholder secret is supplied.
# PRIVATE_CONTENT_LOCAL_MASTER_KEY=""
# PRIVATE_CONTENT_KMS_REGION="us-east-1"
# PRIVATE_CONTENT_KMS_KEY_ID="alias/forever-treasure-private"
# PRIVATE_CONTENT_KMS_ENDPOINT="https://kms.us-east-1.amazonaws.com"
# PRIVATE_CONTENT_KMS_ENCRYPTION_CONTEXT_ENV='{"environment":"local-development","purpose":"sealed-hold"}'
PRIVATE_CONTENT_WORKER_ENABLED="false"
PRIVATE_CONTENT_WORKER_CONCURRENCY="2"
PRIVATE_CONTENT_WORKER_LEASE_MS="30000"
PRIVATE_CONTENT_WORKER_POLL_MS="3000"
PRIVATE_CONTENT_REQUIRE_READY="true"
PRIVATE_CONTENT_GC_GRACE_DAYS="30"
PRIVATE_CONTENT_QUARANTINE_RETENTION_DAYS="90"
PRIVATE_CONTENT_RESTORE_MODE="isolated-only"
# Schedules are durable enqueue windows, never direct destructive timer actions.
PRIVATE_CONTENT_BACKUP_SCHEDULE="daily"
PRIVATE_CONTENT_RECONCILE_SCHEDULE="hourly"
PRIVATE_CONTENT_CLEANUP_SCHEDULE="daily"
PRIVATE_CONTENT_BACKUP_DAILY_RETENTION="14"
PRIVATE_CONTENT_BACKUP_WEEKLY_RETENTION="8"
# Harborlight is internal-only in Phase 1. Do not enable public publishing.
COMMUNITY_ENABLED="true"
COMMUNITY_PUBLIC_PUBLISHING_ENABLED="false"
COMMUNITY_MODERATION_REQUIRED="true"
COMMUNITY_ASSET_STORAGE_PROVIDER="local"
# COMMUNITY_ASSET_ROOT="D:\\ForeverTreasureCommunityAssets"
COMMUNITY_WORKER_ENABLED="false"
COMMUNITY_RATE_LIMIT_PROFILE="10"
# COMMUNITY_PUBLIC_BASE_URL="http://127.0.0.1:3000"
# Phase 4 secure-harbor configuration. Do not put real provider credentials or
# endpoints in this file; deployment secrets are injected by the host.
COMMUNITY_ROLLOUT_STAGE="INTERNAL_ONLY"
COMMUNITY_SCANNER_PROVIDER="not-configured"
# COMMUNITY_CLAMAV_HOST="127.0.0.1"
COMMUNITY_CLAMAV_PORT="3310"
COMMUNITY_CLAMAV_TIMEOUT_MS="15000"
COMMUNITY_SCAN_MAX_AGE_MS="86400000"
COMMUNITY_RATE_LIMIT_PROVIDER="process-local"
COMMUNITY_REQUIRE_ADMIN_FOR_HIGH_IMPACT="true"
# COMMUNITY_BACKUP_ROOT="D:\\ForeverTreasureCommunityBackups"
# COMMUNITY_ALERT_WEBHOOK_URL=""
