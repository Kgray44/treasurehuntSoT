# Bridgewatch is private and loopback-only by default.
BRIDGEWATCH_HOST=127.0.0.1
BRIDGEWATCH_PORT=4318
BRIDGEWATCH_REPOSITORY=forever-treasure/forever-treasure-companion
BRIDGEWATCH_DEFAULT_BRANCH=main
BRIDGEWATCH_DB_PATH=./var/bridgewatch.sqlite
BRIDGEWATCH_GITHUB_API=https://api.github.com
# Optional; keep this server-side only. Never put it in browser code.
# BRIDGEWATCH_GITHUB_TOKEN=
BRIDGEWATCH_REQUEST_TIMEOUT_MS=8000
BRIDGEWATCH_CACHE_TTL_MS=300000
BRIDGEWATCH_POLL_INTERVAL_MS=0
BRIDGEWATCH_MAX_CONCURRENCY=4
