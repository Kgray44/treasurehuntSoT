# Bridgewatch is private and loopback-only by default.
BRIDGEWATCH_HOST=127.0.0.1
BRIDGEWATCH_PORT=4318
BRIDGEWATCH_REPOSITORY=forever-treasure/forever-treasure-companion
BRIDGEWATCH_DEFAULT_BRANCH=main
BRIDGEWATCH_DB_PATH=./var/bridgewatch.sqlite
BRIDGEWATCH_GITHUB_API=https://api.github.com
# Optional; keep this server-side only. Never put it in browser code.
# BRIDGEWATCH_GITHUB_TOKEN=
# Preferred high-volume read credential. These values name only server-side
# configuration; keep the private key outside this repository and never set it
# in browser-visible variables. When configured, the App read pool is used
# before the optional interactive user token above.
# BRIDGEWATCH_GITHUB_APP_ID=
# BRIDGEWATCH_GITHUB_APP_INSTALLATION_ID=
# BRIDGEWATCH_GITHUB_APP_PRIVATE_KEY_PATH=C:\\Secure\\voyagewright-automation.pem
# Optional parent directory for shared, non-secret GitHub cache/rate state.
# BRIDGEWATCH_GITHUB_STATE_DIR=C:\\Bridgewatch\\github-interaction
BRIDGEWATCH_REQUEST_TIMEOUT_MS=8000
# v1.2 normalized-history and comparison defaults. These values are not secrets.
BRIDGEWATCH_SNAPSHOT_INTERVAL_MS=60000
BRIDGEWATCH_SOUNDING_LINE_POLL_INTERVAL_MS=10000
BRIDGEWATCH_EVENT_RETENTION_DAYS=30
BRIDGEWATCH_ROLLUP_RETENTION_DAYS=90
BRIDGEWATCH_HISTORY_PAGE_SIZE=100
BRIDGEWATCH_HISTORY_MAX_RANGE_HOURS=720
BRIDGEWATCH_BRANCH_STALE_MS=604800000
BRIDGEWATCH_REVIEW_BRANCH_STALE_MS=259200000
BRIDGEWATCH_BRANCH_BEHIND_THRESHOLD=5
BRIDGEWATCH_GITHUB_MAX_BRANCHES=30
# Machine-only telemetry uses this distinct token only; it is never a GitHub,
# Sounding Line, Cloudflare, or application-session credential.
# BRIDGEWATCH_TELEMETRY_TOKEN=
BRIDGEWATCH_TELEMETRY_STALE_MS=90000
BRIDGEWATCH_TELEMETRY_MAX_BODY_BYTES=4096
# Optional schema-versioned, read-only Sounding Line status projection path.
# BRIDGEWATCH_SOUNDING_LINE_PROJECTION_PATH=
# External deployment is opt-in and requires Basic authentication for the
# dashboard plus its human observation APIs. Keep these server-side only.
# BRIDGEWATCH_ALLOW_EXTERNAL=true
# BRIDGEWATCH_DASHBOARD_USERNAME=
# BRIDGEWATCH_DASHBOARD_PASSWORD=
