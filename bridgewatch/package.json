{
  "name": "@forever-treasure/bridgewatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch lib/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/lib/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run test",
    "refresh": "tsx lib/cli.ts refresh",
    "prune-cache": "tsx src/cli.ts prune-cache",
    "report-heartbeat": "tsx lib/reporter.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
