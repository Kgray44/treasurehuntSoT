{
  "version": "2.0.0",
  "status": "stage-10-complete-owned-family-dispositions",
  "defaultDisposition": "REGISTERED_SUITE_CHILD",
  "rules": [
    {
      "match": "tests/e2e/**",
      "suiteId": "browser.cross-project",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "platform-foundation",
      "tier": 4,
      "parallelSafety": "ISOLATED_MUTABLE_PARALLEL",
      "adapter": "playwright"
    },
    {
      "match": "tests/private-content/**",
      "suiteId": "unit.private-content",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "sealed-hold",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/private-content/**",
      "suiteId": "unit.private-content",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "sealed-hold",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/community/**",
      "suiteId": "unit.community",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "harborlight",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/wayfarer/**",
      "suiteId": "unit.wayfarer",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "wayfarer",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/animation/**",
      "suiteId": "unit.animation",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "lanternwake",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/chronicle/**",
      "suiteId": "unit.one-voyage",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "one-voyage",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "src/navigation/**",
      "suiteId": "unit.true-north",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "platform-foundation",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "scripts/sounding-line/**",
      "suiteId": "unit.sounding-line",
      "role": "REGISTERED_ADAPTER",
      "owner": "platform-foundation",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "node"
    },
    {
      "match": "tests/sounding-line/**",
      "suiteId": "unit.sounding-line",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "platform-foundation",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "node"
    },
    {
      "match": "scripts/features/**",
      "suiteId": "unit.feature-catalog",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "platform-foundation",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    },
    {
      "match": "scripts/*.ps1",
      "suiteId": "validation.powershell",
      "role": "REGISTERED_ADAPTER",
      "owner": "breakwater",
      "tier": 3,
      "parallelSafety": "SERIAL_EXCEPTION",
      "adapter": "powershell"
    },
    {
      "match": "src/**",
      "suiteId": "unit.platform-foundation",
      "role": "REGISTERED_SUITE_CHILD",
      "owner": "platform-foundation",
      "tier": 1,
      "parallelSafety": "READ_ONLY_PARALLEL",
      "adapter": "vitest"
    }
  ]
}
